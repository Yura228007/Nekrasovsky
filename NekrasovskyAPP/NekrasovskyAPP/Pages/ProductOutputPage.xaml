<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NekrasovskyAPP.Pages.ProductOutputPage"
             BackgroundColor="{StaticResource BackgroundDark}"
             Title="Упаковка продукции">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Добавить" Clicked="OnAddClicked" />
        <ToolbarItem Text="Обновить" Clicked="OnRefreshClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*" Padding="16">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,4,0,12">
            <VerticalStackLayout>
                    <Label Text="Упаковка продукции"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}" />
                <Label Text="Произведено, брак, эко, перемотка"
                       FontSize="12"
                       TextColor="{StaticResource Gray500}" />
            </VerticalStackLayout>
            <Border Grid.Column="1"
                    BackgroundColor="{StaticResource CardProducts}"
                    WidthRequest="44"
                    HeightRequest="44"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Label Text="📊" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
        </Grid>

        <!-- Summary Cards -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="8" Margin="0,0,0,12">
            <!-- Произведено -->
            <Border Grid.Column="0"
                    BackgroundColor="{StaticResource Success}"
                    StrokeThickness="0"
                    Padding="10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Произв."
                           FontSize="10"
                           TextColor="{StaticResource White}"
                           Opacity="0.8" />
                    <Label x:Name="TotalProducedLabel"
                           Text="0"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}" />
                </VerticalStackLayout>
            </Border>

            <!-- Брак -->
            <Border Grid.Column="1"
                    BackgroundColor="{StaticResource Error}"
                    StrokeThickness="0"
                    Padding="10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Брак"
                           FontSize="10"
                           TextColor="{StaticResource White}"
                           Opacity="0.8" />
                    <Label x:Name="TotalDefectLabel"
                           Text="0"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}" />
                </VerticalStackLayout>
            </Border>

            <!-- Эко -->
            <Border Grid.Column="2"
                    BackgroundColor="{StaticResource CardMaterials}"
                    StrokeThickness="0"
                    Padding="10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Эко"
                           FontSize="10"
                           TextColor="{StaticResource White}"
                           Opacity="0.8" />
                    <Label x:Name="TotalEcoLabel"
                           Text="0"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}" />
                </VerticalStackLayout>
            </Border>

            <!-- Перемотка -->
            <Border Grid.Column="3"
                    BackgroundColor="{StaticResource CardReprocess}"
                    StrokeThickness="0"
                    Padding="10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Перемот."
                           FontSize="10"
                           TextColor="{StaticResource White}"
                           Opacity="0.8" />
                    <Label x:Name="TotalRewindLabel"
                           Text="0"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Output List -->
        <RefreshView Grid.Row="2"
                     x:Name="RefreshViewControl"
                     Refreshing="OnRefreshing">
            <CollectionView x:Name="OutputsCollectionView"
                            SelectionMode="Single"
                            SelectionChanged="OnOutputSelected">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="12">
                        <Border BackgroundColor="{StaticResource BackgroundCard}"
                                WidthRequest="80"
                                HeightRequest="80"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20"/>
                            </Border.StrokeShape>
                            <Label Text="📭" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                            <Label Text="Нет записей об упаковке"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray400}"
                               HorizontalOptions="Center" />
                        <Label Text="Добавьте первую запись"
                               FontSize="13"
                               TextColor="{StaticResource Gray500}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{StaticResource BackgroundCard}"
                                StrokeThickness="0"
                                Margin="0,0,0,10"
                                Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border Grid.Column="0"
                                        BackgroundColor="{StaticResource CardProducts}"
                                        WidthRequest="48"
                                        HeightRequest="48"
                                        StrokeThickness="0"
                                        VerticalOptions="Start">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Label Text="📦" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <Label Text="{Binding ProductName}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource White}" />
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                        <!-- Произведено -->
                                        <HorizontalStackLayout Grid.Column="0" Spacing="4">
                                            <Label Text="+"
                                                   FontSize="12"
                                                   TextColor="{StaticResource Success}" />
                                            <Label Text="{Binding ProducedQuantity}"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Success}" />
                                        </HorizontalStackLayout>
                                        <!-- Брак -->
                                        <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                            <Label Text="!"
                                                   FontSize="12"
                                                   TextColor="{StaticResource Error}" />
                                            <Label Text="{Binding DefectQuantity}"
                                                   FontSize="13"
                                                   TextColor="{StaticResource Error}" />
                                        </HorizontalStackLayout>
                                        <!-- Эко -->
                                        <HorizontalStackLayout Grid.Column="2" Spacing="4">
                                            <Label Text="~"
                                                   FontSize="12"
                                                   TextColor="{StaticResource CardMaterials}" />
                                            <Label Text="{Binding EcoQuantity}"
                                                   FontSize="13"
                                                   TextColor="{StaticResource CardMaterials}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <HorizontalStackLayout Spacing="12">
                                        <Label Text="{Binding CreatedAtDisplay}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray500}" />
                                        <Label Text="{Binding MachineName}"
                                               FontSize="12"
                                               TextColor="{StaticResource Primary}" />
                                        <Label Text="{Binding WarehouseName}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray400}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="2"
                           x:Name="LoadingIndicator"
                           IsRunning="False"
                           IsVisible="False"
                           Color="{StaticResource Primary}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />
    </Grid>
</ContentPage>
