<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:NekrasovskyAPP.Converters"
             x:Class="NekrasovskyAPP.Pages.MaterialsPage"
             BackgroundColor="{StaticResource BackgroundDark}">
    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Обновить" Clicked="OnRefreshClicked" />
        <ToolbarItem x:Name="ScanToolbarItem" Text="Сканировать" Clicked="OnScanBarcodeClicked" />
        <ToolbarItem x:Name="AddToolbarItem" Text="Добавить" Clicked="OnAddClicked" />
    </ContentPage.ToolbarItems>
    
    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,4,0,12">
            <VerticalStackLayout>
                <Label Text="Материалы"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource White}" />
                <Label Text="Сырье и компоненты"
                       FontSize="12"
                       TextColor="{StaticResource Gray500}" />
            </VerticalStackLayout>
            <Border Grid.Column="1"
                    BackgroundColor="{StaticResource CardMaterials}"
                    WidthRequest="44"
                    HeightRequest="44"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Label Text="🔧" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
        </Grid>

        <!-- Search Bar -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource BackgroundCard}"
                StrokeThickness="0"
                Padding="0"
                HeightRequest="48"
                Margin="0,0,0,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="48,*" VerticalOptions="Center">
                <Label Text="🔍"
                       FontSize="18"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                <Entry Grid.Column="1"
                       x:Name="SearchEntry"
                       Placeholder="Поиск по названию или коду..."
                       TextChanged="OnSearchTextChanged"
                       TextColor="{StaticResource White}"
                       PlaceholderColor="{StaticResource Gray600}"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Filter Panel -->
        <Border Grid.Row="2"
                BackgroundColor="{StaticResource BackgroundCard}"
                StrokeThickness="0"
                Padding="12"
                Margin="0,0,0,12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <!-- Фильтр по статусу -->
                <Border Grid.Column="0"
                        BackgroundColor="{StaticResource BackgroundInput}"
                        StrokeThickness="0"
                        Padding="8,0"
                        HeightRequest="{OnIdiom Phone=40, Tablet=44, Desktop=58}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Picker x:Name="StatusPicker"
                            Title="Статус"
                            SelectedIndexChanged="OnFilterChanged"
                            TextColor="{StaticResource White}"
                            TitleColor="{StaticResource Gray500}"
                            FontSize="13">
                        <Picker.Items>
                            <x:String>Все</x:String>
                            <x:String>Активные</x:String>
                            <x:String>Неактивные</x:String>
                        </Picker.Items>
                    </Picker>
                </Border>

                <!-- Сортировка -->
                <Border Grid.Column="1"
                        BackgroundColor="{StaticResource BackgroundInput}"
                        StrokeThickness="0"
                        Padding="8,0"
                        HeightRequest="{OnIdiom Phone=40, Tablet=44, Desktop=58}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Picker x:Name="SortPicker"
                            Title="Сортировка"
                            SelectedIndexChanged="OnFilterChanged"
                            TextColor="{StaticResource White}"
                            TitleColor="{StaticResource Gray500}"
                            FontSize="13">
                        <Picker.Items>
                            <x:String>По имени ↑</x:String>
                            <x:String>По имени ↓</x:String>
                            <x:String>По коду ↑</x:String>
                            <x:String>По коду ↓</x:String>
                        </Picker.Items>
                    </Picker>
                </Border>
            </Grid>
        </Border>

        <!-- Materials List -->
        <RefreshView Grid.Row="3"
                     Refreshing="OnRefreshing">
            <CollectionView x:Name="MaterialsCollectionView"
                            ItemsSource="{Binding Materials}"
                            SelectionMode="Single"
                            SelectionChanged="OnMaterialSelected">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="12">
                        <Border BackgroundColor="{StaticResource BackgroundCard}"
                                WidthRequest="80"
                                HeightRequest="80"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20"/>
                            </Border.StrokeShape>
                            <Label Text="📭" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Материалы не найдены"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray400}"
                               HorizontalOptions="Center" />
                        <Label Text="Попробуйте изменить поисковый запрос"
                               FontSize="13"
                               TextColor="{StaticResource Gray500}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{StaticResource BackgroundCard}"
                                StrokeThickness="0"
                                Margin="0,0,0,10"
                                Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Border Grid.Column="0"
                                        BackgroundColor="{StaticResource CardMaterials}"
                                        WidthRequest="48"
                                        HeightRequest="48"
                                        StrokeThickness="0"
                                        VerticalOptions="Start">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Label Text="🔧" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Start">
                                    <Label Text="{Binding Name}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource White}" />
                                    <Label Text="{Binding ResponsibilityDisplay}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}"
                                           IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ShowResponsibility}" />
                                    <HorizontalStackLayout Spacing="12">
                                        <Label Text="{Binding Code, StringFormat='Код: {0}'}"
                                               FontSize="13"
                                               TextColor="{StaticResource Gray400}" />
                                        <Label Text="{Binding MeasuringUnit}"
                                               FontSize="13"
                                               TextColor="{StaticResource CardMaterials}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <Border Grid.Column="2"
                                        BackgroundColor="{StaticResource BackgroundElevated}"
                                        StrokeThickness="0"
                                        Padding="10,6"
                                        VerticalOptions="Start"
                                        MinimumWidthRequest="120">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8"/>
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding StockSummary}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray400}"
                                               IsVisible="{Binding HasResponsibility, Converter={StaticResource InvertedBoolConverter}}" />
                                        <Label Text="{Binding WarehouseStocksDisplay}"
                                               FontSize="11"
                                               TextColor="{StaticResource Gray400}"
                                               IsVisible="{Binding HasWarehouseStocks}"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="3"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource Primary}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />
    </Grid>
    
</ContentPage>
