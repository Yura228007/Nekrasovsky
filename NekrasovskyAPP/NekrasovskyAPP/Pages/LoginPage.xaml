<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:NekrasovskyAPP.Converters"
             x:Class="NekrasovskyAPP.Pages.LoginPage"
             Title="Вход в систему"
             BackgroundColor="{StaticResource BackgroundDark}">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <ScrollView>
        <VerticalStackLayout 
            Spacing="25" 
            Padding="30,0"
            VerticalOptions="Center"
            HorizontalOptions="Center">
            
            <!-- Logo/Header -->
            <Label Text="Nekrasovsky"
                   FontSize="42"
                   FontAttributes="Bold"
                   TextColor="{StaticResource White}"
                   HorizontalOptions="Center"
                   Margin="0,50,0,10" />
            
            <Label Text="Система управления складом"
                   FontSize="16"
                   TextColor="{StaticResource Gray400}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,50" />
            
            <!-- Login Card -->
            <Border BackgroundColor="{StaticResource BackgroundCard}"
                    StrokeThickness="1"
                    Stroke="{StaticResource BorderColor}"
                    Padding="30"
                    Margin="0,0,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="20">
                    
                    <Label Text="Вход в систему"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}"
                           HorizontalOptions="Center"
                           Margin="0,0,0,10" />
                    
                    <!-- Login Entry -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Логин"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray400}" />
                        <Border BackgroundColor="{StaticResource BackgroundElevated}"
                                StrokeThickness="1"
                                Stroke="{StaticResource BorderColor}"
                                Padding="15,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Entry x:Name="LoginEntry"
                                   Placeholder="Введите логин"
                                   Text="{Binding Login}"
                                   Keyboard="Default"
                                   TextColor="{StaticResource Gray200}"
                                   PlaceholderColor="{StaticResource Gray600}"
                                   BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>
                    
                    <!-- Password Entry -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Пароль"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray400}" />
                        <Border BackgroundColor="{StaticResource BackgroundElevated}"
                                StrokeThickness="1"
                                Stroke="{StaticResource BorderColor}"
                                Padding="15,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Entry x:Name="PasswordEntry"
                                   Placeholder="Введите пароль"
                                   Text="{Binding Password}"
                                   IsPassword="True"
                                   Keyboard="Default"
                                   TextColor="{StaticResource Gray200}"
                                   PlaceholderColor="{StaticResource Gray600}"
                                   BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>
                    
                    <!-- Error Message -->
                    <Label x:Name="ErrorMessageLabel"
                           Text="{Binding ErrorMessage}"
                           TextColor="{StaticResource Error}"
                           IsVisible="{Binding HasError}"
                           HorizontalOptions="Center"
                           FontSize="12" />
                    
                    <!-- Login Button -->
                    <Button Text="Войти"
                            Clicked="OnLoginClicked"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource White}"
                            CornerRadius="10"
                            HeightRequest="50"
                            FontSize="16"
                            FontAttributes="Bold"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" />
                    
                    <!-- Loading Indicator -->
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                     IsVisible="{Binding IsLoading}"
                                     Color="{StaticResource Accent}"
                                     HorizontalOptions="Center"
                                     Margin="0,10,0,0" />
                    
                </VerticalStackLayout>
            </Border>
            
        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>
