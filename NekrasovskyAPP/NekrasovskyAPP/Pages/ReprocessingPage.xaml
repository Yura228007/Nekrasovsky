<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NekrasovskyAPP.Pages.ReprocessingPage"
             BackgroundColor="{StaticResource BackgroundDark}"
             Title="Переработать">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,12">
                <VerticalStackLayout>
                    <Label Text="Переработка"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}" />
                    <Label Text="Обработка материалов"
                           FontSize="12"
                           TextColor="{StaticResource Gray500}" />
                </VerticalStackLayout>
                <Border Grid.Column="1"
                        BackgroundColor="{StaticResource CardReprocess}"
                        WidthRequest="44"
                        HeightRequest="44"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Label Text="♻️" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </Grid>

            <!-- Source Section -->
            <Border BackgroundColor="{StaticResource BackgroundCard}"
                    StrokeThickness="0"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <HorizontalStackLayout Spacing="10">
                        <Border BackgroundColor="{StaticResource CardMaterials}"
                                WidthRequest="32"
                                HeightRequest="32"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Label Text="📥" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Исходные данные"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Склад"
                               FontSize="13"
                               TextColor="{StaticResource Gray400}" />
                        <Border BackgroundColor="{StaticResource BackgroundInput}"
                                StrokeThickness="0"
                                Padding="12,0"
                                HeightRequest="48">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Picker x:Name="WarehousePicker"
                                    Title="Выберите склад"
                                    ItemDisplayBinding="{Binding Name}"
                                    TextColor="{StaticResource White}"
                                    TitleColor="{StaticResource Gray500}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Исходный материал"
                               FontSize="13"
                               TextColor="{StaticResource Gray400}" />
                        <Border BackgroundColor="{StaticResource BackgroundInput}"
                                StrokeThickness="0"
                                Padding="12,0"
                                HeightRequest="48">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Picker x:Name="SourceMaterialPicker"
                                    Title="Выберите материал"
                                    ItemDisplayBinding="{Binding Name}"
                                    TextColor="{StaticResource White}"
                                    TitleColor="{StaticResource Gray500}" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Количество"
                               FontSize="13"
                               TextColor="{StaticResource Gray400}" />
                        <Border BackgroundColor="{StaticResource BackgroundInput}"
                                StrokeThickness="0"
                                Padding="12,0"
                                HeightRequest="48">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Entry x:Name="SourceQuantityEntry"
                                   Keyboard="Numeric"
                                   Placeholder="0"
                                   TextColor="{StaticResource White}"
                                   PlaceholderColor="{StaticResource Gray600}"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Result 1 Section -->
            <Border BackgroundColor="{StaticResource BackgroundCard}"
                    StrokeThickness="0"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <HorizontalStackLayout Spacing="10">
                        <Border BackgroundColor="{StaticResource CardReprocess}"
                                WidthRequest="32"
                                HeightRequest="32"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Label Text="1️⃣" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Результат 1"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <Border BackgroundColor="{StaticResource BackgroundInput}"
                            StrokeThickness="0"
                            Padding="12,0"
                            HeightRequest="48">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Picker x:Name="Target1TypePicker"
                                Title="Тип результата"
                                SelectedIndexChanged="OnTarget1TypeChanged"
                                TextColor="{StaticResource White}"
                                TitleColor="{StaticResource Gray500}" />
                    </Border>

                    <Border BackgroundColor="{StaticResource BackgroundInput}"
                            StrokeThickness="0"
                            Padding="12,0"
                            HeightRequest="48">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Picker x:Name="Target1Picker"
                                Title="Выберите материал или продукт"
                                TextColor="{StaticResource White}"
                                TitleColor="{StaticResource Gray500}" />
                    </Border>

                    <Border BackgroundColor="{StaticResource BackgroundInput}"
                            StrokeThickness="0"
                            Padding="12,0"
                            HeightRequest="48">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Entry x:Name="Target1QuantityEntry"
                               Keyboard="Numeric"
                               Placeholder="Количество"
                               TextColor="{StaticResource White}"
                               PlaceholderColor="{StaticResource Gray600}"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Second Output Toggle -->
            <Border BackgroundColor="{StaticResource BackgroundCard}"
                    StrokeThickness="0"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Второй результат"
                           FontSize="14"
                           TextColor="{StaticResource White}"
                           VerticalOptions="Center" />
                    <Switch Grid.Column="1"
                            x:Name="SecondOutputSwitch"
                            Toggled="OnSecondOutputToggled"
                            OnColor="{StaticResource Primary}"
                            ThumbColor="{StaticResource White}" />
                </Grid>
            </Border>

            <!-- Result 2 Section -->
            <Border x:Name="SecondOutputBlock"
                    IsVisible="False"
                    BackgroundColor="{StaticResource BackgroundCard}"
                    StrokeThickness="0"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <HorizontalStackLayout Spacing="10">
                        <Border BackgroundColor="{StaticResource CardReprocess}"
                                WidthRequest="32"
                                HeightRequest="32"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Label Text="2️⃣" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Результат 2"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <Border BackgroundColor="{StaticResource BackgroundInput}"
                            StrokeThickness="0"
                            Padding="12,0"
                            HeightRequest="48">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Picker x:Name="Target2TypePicker"
                                Title="Тип результата 2"
                                SelectedIndexChanged="OnTarget2TypeChanged"
                                TextColor="{StaticResource White}"
                                TitleColor="{StaticResource Gray500}" />
                    </Border>

                    <Border BackgroundColor="{StaticResource BackgroundInput}"
                            StrokeThickness="0"
                            Padding="12,0"
                            HeightRequest="48">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Picker x:Name="Target2Picker"
                                Title="Выберите материал или продукт"
                                TextColor="{StaticResource White}"
                                TitleColor="{StaticResource Gray500}" />
                    </Border>

                    <Border BackgroundColor="{StaticResource BackgroundInput}"
                            StrokeThickness="0"
                            Padding="12,0"
                            HeightRequest="48">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Entry x:Name="Target2QuantityEntry"
                               Keyboard="Numeric"
                               Placeholder="Количество"
                               TextColor="{StaticResource White}"
                               PlaceholderColor="{StaticResource Gray600}"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Submit Button -->
            <Button Text="Переработать"
                    Clicked="OnSubmitClicked"
                    BackgroundColor="{StaticResource CardReprocess}"
                    TextColor="{StaticResource White}"
                    CornerRadius="14"
                    HeightRequest="52"
                    FontSize="16"
                    FontAttributes="Bold"
                    Margin="0,8,0,16" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
