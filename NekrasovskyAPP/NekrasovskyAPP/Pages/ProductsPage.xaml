<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:NekrasovskyAPP.Converters"
             x:Class="NekrasovskyAPP.Pages.ProductsPage"
             Title="Продукты"
             BackgroundColor="{StaticResource BackgroundDark}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Обновить" Clicked="OnRefreshClicked" />
        <ToolbarItem Text="Сканировать" Clicked="OnScanBarcodeClicked" />
        <ToolbarItem Text="Добавить" Clicked="OnAddClicked" />
    </ContentPage.ToolbarItems>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <!-- Search Bar -->
        <Border Grid.Row="0" 
                BackgroundColor="{StaticResource BackgroundCard}"
                StrokeThickness="1"
                Stroke="{StaticResource BorderColor}"
                Padding="15,12"
                Margin="15,15,15,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>
            <Entry x:Name="SearchEntry"
                   Placeholder="Поиск по названию или коду..."
                   TextChanged="OnSearchTextChanged"
                   TextColor="{StaticResource Gray200}"
                   PlaceholderColor="{StaticResource Gray600}"
                   BackgroundColor="Transparent" />
        </Border>

        <!-- Filter Panel -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource BackgroundCard}"
                StrokeThickness="1"
                Stroke="{StaticResource BorderColor}"
                Padding="15,10"
                Margin="15,0,15,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Фильтр по статусу -->
                <Picker Grid.Column="0"
                        x:Name="StatusPicker"
                        Title="Статус"
                        SelectedIndexChanged="OnFilterChanged"
                        TextColor="{StaticResource Gray200}"
                        TitleColor="{StaticResource Gray600}"
                        Margin="0,0,5,0">
                    <Picker.Items>
                        <x:String>Все</x:String>
                        <x:String>Активные</x:String>
                        <x:String>Неактивные</x:String>
                    </Picker.Items>
                </Picker>

                <!-- Сортировка -->
                <Picker Grid.Column="1"
                        x:Name="SortPicker"
                        Title="Сортировка"
                        SelectedIndexChanged="OnFilterChanged"
                        TextColor="{StaticResource Gray200}"
                        TitleColor="{StaticResource Gray600}"
                        Margin="5,0,0,0">
                    <Picker.Items>
                        <x:String>По имени ↑</x:String>
                        <x:String>По имени ↓</x:String>
                        <x:String>По коду ↑</x:String>
                        <x:String>По коду ↓</x:String>
                    </Picker.Items>
                </Picker>
            </Grid>
        </Border>

        <!-- Products List -->
        <RefreshView Grid.Row="2" 
                     IsRefreshing="{Binding IsLoading}"
                     Refreshing="OnRefreshing">
            <CollectionView x:Name="ProductsCollectionView"
                          ItemsSource="{Binding Products}"
                          SelectionMode="Single"
                          SelectionChanged="OnProductSelected">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" 
                               VerticalOptions="Center"
                               Spacing="10"
                               Margin="20">
                        <Label Text="Товары не найдены"
                       FontSize="16"
                       TextColor="{StaticResource Gray500}"
                       HorizontalOptions="Center" />
                        <Label Text="Попробуйте изменить поисковый запрос"
                       FontSize="14"
                       TextColor="{StaticResource Gray600}"
                       HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{StaticResource BackgroundCard}"
                                StrokeThickness="1"
                                Stroke="{StaticResource BorderColor}"
                                Margin="15,8"
                                Padding="18">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding Name}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource White}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Code, StringFormat='Код: {0}'}"
                                       FontSize="14"
                                       TextColor="{StaticResource Gray400}" />
                                <Label Text="{Binding MeasuringUnit, StringFormat='Ед. измерения: {0}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray600}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        
        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="2"
                          IsRunning="{Binding IsLoading}"
                          IsVisible="{Binding IsLoading}"
                          Color="{StaticResource Accent}"
                          VerticalOptions="Center"
                          HorizontalOptions="Center" />
    </Grid>
    
</ContentPage>
