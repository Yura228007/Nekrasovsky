<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NekrasovskyAPP.Pages.HomePage"
             BackgroundColor="{StaticResource BackgroundDark}">
    
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Выход" Clicked="OnLogoutClicked" />
    </ContentPage.ToolbarItems>
    
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Header Section -->
            <Grid ColumnDefinitions="*,Auto" Margin="4,8,4,16">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="Nekrasovsky"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}" />
                    <Label Text="{Binding CurrentUserName, StringFormat='Добро пожаловать, {0}'}"
                           FontSize="14"
                           TextColor="{StaticResource Gray400}" />
                </VerticalStackLayout>
                <Border Grid.Column="1"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="0"
                        WidthRequest="48"
                        HeightRequest="48"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24"/>
                    </Border.StrokeShape>
                    <Label Text="👤"
                           FontSize="24"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Navigation Cards -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                <!-- Scanner Card -->
                <Border x:Name="ScannerCard"
                        Grid.Row="0" Grid.Column="0"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnScannerClicked"/>
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <Border Grid.Row="0"
                                BackgroundColor="{StaticResource CardScanner}"
                                WidthRequest="56"
                                HeightRequest="56"
                                HorizontalOptions="Start"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Label Text="📷" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Row="1"
                               Text="Сканер"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               Margin="0,4,0,0"/>
                        <Label Grid.Row="2"
                               Text="Сканировать штрихкод"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}"/>
                    </Grid>
                </Border>

                <!-- Product Batches Card -->
                <Border Grid.Row="0" Grid.Column="1"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProductBatchesClicked"/>
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <Border Grid.Row="0"
                                BackgroundColor="#9b59b6"
                                WidthRequest="56"
                                HeightRequest="56"
                                HorizontalOptions="Start"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Label Text="📦" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Row="1"
                               Text="Партии"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               Margin="0,4,0,0"/>
                        <Label Grid.Row="2"
                               Text="Партии продукции"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}"/>
                    </Grid>
                </Border>

                <!-- Materials Card -->
                <Border Grid.Row="1" Grid.Column="0"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMaterialsClicked"/>
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <Border Grid.Row="0"
                                BackgroundColor="{StaticResource CardMaterials}"
                                WidthRequest="56"
                                HeightRequest="56"
                                HorizontalOptions="Start"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Label Text="🔧" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Row="1"
                               Text="Материалы"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               Margin="0,4,0,0"/>
                        <Label Grid.Row="2"
                               Text="Сырье и компоненты"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}"/>
                    </Grid>
                </Border>

                <!-- Warehouses Card -->
                <Border Grid.Row="1" Grid.Column="1"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnWarehousesClicked"/>
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <Border Grid.Row="0"
                                BackgroundColor="{StaticResource CardWarehouses}"
                                WidthRequest="56"
                                HeightRequest="56"
                                HorizontalOptions="Start"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Label Text="🏭" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Row="1"
                               Text="Склады"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               Margin="0,4,0,0"/>
                        <Label Grid.Row="2"
                               Text="Управление складами"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}"/>
                    </Grid>
                </Border>

                <!-- Reports Card -->
                <Border x:Name="WorkReportsCard"
                        Grid.Row="2" Grid.Column="0"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnWorkReportsClicked"/>
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <Border Grid.Row="0"
                                BackgroundColor="{StaticResource CardReports}"
                                WidthRequest="56"
                                HeightRequest="56"
                                HorizontalOptions="Start"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Label Text="📊" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Row="1"
                               Text="Отчеты"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               Margin="0,4,0,0"/>
                        <Label Grid.Row="2"
                               Text="Рабочие отчеты"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}"/>
                    </Grid>
                </Border>

                <!-- Requests Card -->
                <Border Grid.Row="2" Grid.Column="1"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPartRequestsClicked"/>
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <Border Grid.Row="0"
                                BackgroundColor="{StaticResource CardRequests}"
                                WidthRequest="56"
                                HeightRequest="56"
                                HorizontalOptions="Start"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Label Text="📋" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Row="1"
                               Text="Запросы"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               Margin="0,4,0,0"/>
                        <Label Grid.Row="2"
                               Text="Запросы деталей"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}"/>
                    </Grid>
                </Border>

                <!-- Shift Transfers Card -->
                <Border x:Name="ShiftTransfersCard"
                        Grid.Row="3" Grid.Column="0"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnShiftTransfersClicked"/>
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <Border Grid.Row="0"
                                BackgroundColor="{StaticResource CardShift}"
                                WidthRequest="56"
                                HeightRequest="56"
                                HorizontalOptions="Start"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Label Text="🔄" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Row="1"
                               Text="Смена"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               Margin="0,4,0,0"/>
                        <Label Grid.Row="2"
                               Text="Передача смены"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}"/>
                    </Grid>
                </Border>

                <!-- Reprocessing Card -->
                <Border x:Name="ReprocessingCard"
                        Grid.Row="3" Grid.Column="1"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnReprocessingClicked"/>
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <Border Grid.Row="0"
                                BackgroundColor="{StaticResource CardReprocess}"
                                WidthRequest="56"
                                HeightRequest="56"
                                HorizontalOptions="Start"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Label Text="♻️" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Row="1"
                               Text="Переработка"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               Margin="0,4,0,0"/>
                        <Label Grid.Row="2"
                               Text="Обработка материалов"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}"/>
                    </Grid>
                </Border>

                <!-- Disposal Card -->
                <Border x:Name="DisposalCard"
                        Grid.Row="4" Grid.Column="0"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDisposalClicked"/>
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <Border Grid.Row="0"
                                BackgroundColor="{StaticResource CardDisposal}"
                                WidthRequest="56"
                                HeightRequest="56"
                                HorizontalOptions="Start"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Label Text="🗑️" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Row="1"
                               Text="Утиль"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               Margin="0,4,0,0"/>
                        <Label Grid.Row="2"
                               Text="Списание и утилизация"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}"/>
                    </Grid>
                </Border>

                <!-- Product Output Card -->
                <Border x:Name="ProductOutputCard"
                        Grid.Row="4" Grid.Column="1"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnProductOutputClicked"/>
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <Border Grid.Row="0"
                                BackgroundColor="{StaticResource CardProducts}"
                                WidthRequest="56"
                                HeightRequest="56"
                                HorizontalOptions="Start"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Label Text="📊" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Row="1"
                               Text="Выпуск"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               Margin="0,4,0,0"/>
                        <Label Grid.Row="2"
                               Text="Произвели, брак, эко"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}"/>
                    </Grid>
                </Border>

                <!-- Mixing Card -->
                <Border x:Name="MixingCard"
                        Grid.Row="5" Grid.Column="0"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMixingClicked"/>
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <Border Grid.Row="0"
                                BackgroundColor="{StaticResource CardMixing}"
                                WidthRequest="56"
                                HeightRequest="56"
                                HorizontalOptions="Start"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Label Text="🧪" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Grid.Row="1"
                               Text="Смешивание"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               Margin="0,4,0,0"/>
                        <Label Grid.Row="2"
                               Text="Смешивание материалов"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}"/>
                    </Grid>
                </Border>

            </Grid>

            <!-- Alarm Button -->
            <Border Margin="0,8,0,16"
                    BackgroundColor="{StaticResource Error}"
                    StrokeThickness="0"
                    Padding="0"
                    HeightRequest="72"
                    HorizontalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAlarmClicked"/>
                </Border.GestureRecognizers>
                <Grid>
                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                        <Label Text="🚨" FontSize="28" VerticalOptions="Center"/>
                        <Label Text="ТРЕВОГА"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>
