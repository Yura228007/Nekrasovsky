<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:NekrasovskyAPP.Converters"
             x:Class="NekrasovskyAPP.Pages.LoginPage"
             BackgroundColor="{StaticResource BackgroundDark}">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <ScrollView>
        <VerticalStackLayout
            Spacing="20"
            Padding="24,0"
            VerticalOptions="Center"
            HorizontalOptions="Fill">

            <!-- Logo Section -->
            <VerticalStackLayout Spacing="12" Margin="0,60,0,20" HorizontalOptions="Center">
                <Border BackgroundColor="{StaticResource Primary}"
                        WidthRequest="80"
                        HeightRequest="80"
                        HorizontalOptions="Center"
                        StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24"/>
                    </Border.StrokeShape>
                    <Label Text="N"
                           FontSize="42"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
                <Label Text="Nekrasovsky"
                       FontSize="36"
                       FontAttributes="Bold"
                       TextColor="{StaticResource White}"
                       HorizontalOptions="Center" />
                <Label Text="Система управления складом"
                       FontSize="14"
                       TextColor="{StaticResource Gray500}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Login Card -->
            <Border BackgroundColor="{StaticResource BackgroundCard}"
                    StrokeThickness="0"
                    Padding="24"
                    HorizontalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="20">

                    <Label Text="Вход в систему"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}"
                           HorizontalOptions="Center"
                           Margin="0,0,0,8" />

                    <!-- Login Entry -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Логин"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray400}" />
                        <Border BackgroundColor="{StaticResource BackgroundInput}"
                                StrokeThickness="1"
                                Stroke="{StaticResource BorderColor}"
                                Padding="0"
                                HeightRequest="52">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="48,*" VerticalOptions="Center">
                                <Label Text="👤"
                                       FontSize="18"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                                <Entry x:Name="LoginEntry"
                                       Grid.Column="1"
                                       Placeholder="Введите логин"
                                       Text="{Binding Login}"
                                       Keyboard="Default"
                                       TextColor="{StaticResource White}"
                                       PlaceholderColor="{StaticResource Gray600}"
                                       BackgroundColor="Transparent"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password Entry -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Пароль"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray400}" />
                        <Border BackgroundColor="{StaticResource BackgroundInput}"
                                StrokeThickness="1"
                                Stroke="{StaticResource BorderColor}"
                                Padding="0"
                                HeightRequest="52">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="48,*" VerticalOptions="Center">
                                <Label Text="🔒"
                                       FontSize="18"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                                <Entry x:Name="PasswordEntry"
                                       Grid.Column="1"
                                       Placeholder="Введите пароль"
                                       Text="{Binding Password}"
                                       IsPassword="True"
                                       Keyboard="Default"
                                       TextColor="{StaticResource White}"
                                       PlaceholderColor="{StaticResource Gray600}"
                                       BackgroundColor="Transparent"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Error Message -->
                    <Border BackgroundColor="#33EF4444"
                            StrokeThickness="0"
                            Padding="12,8"
                            IsVisible="{Binding HasError}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Label x:Name="ErrorMessageLabel"
                               Text="{Binding ErrorMessage}"
                               TextColor="{StaticResource Error}"
                               HorizontalOptions="Center"
                               FontSize="13" />
                    </Border>

                    <!-- Login Button -->
                    <Button Text="Войти"
                            Clicked="OnLoginClicked"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource White}"
                            CornerRadius="12"
                            HeightRequest="52"
                            FontSize="16"
                            FontAttributes="Bold"
                            Margin="0,8,0,0"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" />

                    <!-- Loading Indicator -->
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       Color="{StaticResource Primary}"
                                       HorizontalOptions="Center"
                                       Margin="0,8,0,0" />

                </VerticalStackLayout>
            </Border>

            <!-- Footer -->
            <Label Text="v1.0"
                   FontSize="12"
                   TextColor="{StaticResource Gray600}"
                   HorizontalOptions="Center"
                   Margin="0,20,0,40" />

        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>
