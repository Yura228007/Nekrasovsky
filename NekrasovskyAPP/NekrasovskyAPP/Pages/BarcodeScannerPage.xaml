<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="NekrasovskyAPP.Pages.BarcodeScannerPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:barcode="clr-namespace:BarcodeScanning;assembly=BarcodeScanning.Native.Maui"
             BackgroundColor="Black">

    <Grid>

        <!-- CAMERA -->
        <barcode:CameraView
            x:Name="BarcodeCamera"
            CameraEnabled="{Binding IsCameraEnabled}"
            OnDetectionFinishedCommand="{Binding DetectionFinishedCommand}"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

        <!-- OVERLAY -->
        <Grid RowDefinitions="Auto,*,Auto"
              BackgroundColor="#80000000">

            <!-- HEADER -->
            <Label Grid.Row="0"
                   Text="Наведите камеру на штрих-код или QR-код"
                   TextColor="White"
                   FontSize="16"
                   HorizontalTextAlignment="Center"
                   Padding="16" />

            <!-- SCAN AREA -->
            <Grid Grid.Row="1"
                  HorizontalOptions="Center"
                  VerticalOptions="Center"
                  WidthRequest="260"
                  HeightRequest="260">

                <Frame BorderColor="White"
                       BackgroundColor="Transparent"
                       CornerRadius="12"
                       HasShadow="False"
                       Padding="0" />

            </Grid>

            <!-- FOOTER -->
            <Grid Grid.Row="2"
                  Padding="16"
                  ColumnDefinitions="Auto,*,Auto">

                <!-- FLASH -->
                <Button Text="Фонарик"
                        Clicked="ToggleFlashlight"
                        BackgroundColor="#333333"
                        TextColor="White"
                        CornerRadius="8" />

                <!-- SPACER -->
                <BoxView Grid.Column="1" />

                <!-- CLOSE -->
                <Button Grid.Column="2"
                        Text="Закрыть"
                        Clicked="CloseScanner"
                        BackgroundColor="#AA0000"
                        TextColor="White"
                        CornerRadius="8" />
            </Grid>

        </Grid>
    </Grid>
</ContentPage>
