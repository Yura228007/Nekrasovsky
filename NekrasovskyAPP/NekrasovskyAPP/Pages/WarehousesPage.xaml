<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:NekrasovskyAPP.Converters"
             x:Class="NekrasovskyAPP.Pages.WarehousesPage"
             Title="Склады"
             BackgroundColor="{StaticResource BackgroundDark}">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToStatusTextConverter x:Key="BoolToStatusTextConverter" />
            <converters:BoolToStatusColorConverter x:Key="BoolToStatusColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Обновить" Clicked="OnRefreshClicked" />
        <ToolbarItem Text="Добавить" Clicked="OnAddClicked" />
    </ContentPage.ToolbarItems>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <!-- Search Bar -->
        <Border Grid.Row="0" 
                BackgroundColor="{StaticResource BackgroundCard}"
                StrokeThickness="1"
                Stroke="{StaticResource BorderColor}"
                Padding="15,12"
                Margin="15,15,15,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>
            <Entry x:Name="SearchEntry"
                   Placeholder="Поиск по названию или типу..."
                   TextChanged="OnSearchTextChanged"
                   TextColor="{StaticResource Gray200}"
                   PlaceholderColor="{StaticResource Gray600}"
                   BackgroundColor="Transparent" />
        </Border>

        <!-- Filter Panel -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource BackgroundCard}"
                StrokeThickness="1"
                Stroke="{StaticResource BorderColor}"
                Padding="15,10"
                Margin="15,0,15,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Фильтр по типу -->
                <Picker Grid.Column="0"
                        x:Name="TypePicker"
                        Title="Тип склада"
                        SelectedIndexChanged="OnFilterChanged"
                        TextColor="{StaticResource Gray200}"
                        TitleColor="{StaticResource Gray600}">
                    <Picker.Items>
                        <x:String>Все</x:String>
                        <x:String>Цех</x:String>
                        <x:String>Склад</x:String>
                        <x:String>Производство</x:String>
                    </Picker.Items>
                </Picker>

                <!-- Фильтр по статусу -->
                <Picker Grid.Column="1"
                        x:Name="StatusPicker"
                        Title="Статус"
                        SelectedIndexChanged="OnFilterChanged"
                        TextColor="{StaticResource Gray200}"
                        TitleColor="{StaticResource Gray600}"
                        Margin="5,0">
                    <Picker.Items>
                        <x:String>Все</x:String>
                        <x:String>Активные</x:String>
                        <x:String>Остановлены</x:String>
                    </Picker.Items>
                </Picker>

                <!-- Сортировка -->
                <Picker Grid.Column="2"
                        x:Name="SortPicker"
                        Title="Сортировка"
                        SelectedIndexChanged="OnFilterChanged"
                        TextColor="{StaticResource Gray200}"
                        TitleColor="{StaticResource Gray600}">
                    <Picker.Items>
                        <x:String>По имени ↑</x:String>
                        <x:String>По имени ↓</x:String>
                        <x:String>По типу ↑</x:String>
                        <x:String>По типу ↓</x:String>
                    </Picker.Items>
                </Picker>
            </Grid>
        </Border>

        <!-- Warehouses List -->
        <RefreshView Grid.Row="2" 
                     IsRefreshing="{Binding IsLoading}"
                     Refreshing="OnRefreshing">
            <CollectionView x:Name="WarehousesCollectionView"
                          ItemsSource="{Binding Warehouses}"
                          SelectionMode="Single"
                          SelectionChanged="OnWarehouseSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{StaticResource BackgroundCard}"
                                StrokeThickness="1"
                                Stroke="{StaticResource BorderColor}"
                                Margin="15,8"
                                Padding="18">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding Name}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource White}"
                                           VerticalOptions="Center" />
                                    <Border BackgroundColor="{Binding IsActive, Converter={StaticResource BoolToStatusColorConverter}}"
                                            Padding="8,4">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6"/>
                                        </Border.StrokeShape>
                                        <Label Text="{Binding IsActive, Converter={StaticResource BoolToStatusTextConverter}}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource White}"
                                               VerticalOptions="Center" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Label Text="{Binding Type, StringFormat='Тип: {0}'}"
                                       FontSize="14"
                                       TextColor="{StaticResource Gray400}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        
        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="2"
                          IsRunning="{Binding IsLoading}"
                          IsVisible="{Binding IsLoading}"
                          Color="{StaticResource Accent}"
                          VerticalOptions="Center"
                          HorizontalOptions="Center" />
    </Grid>
    
</ContentPage>
