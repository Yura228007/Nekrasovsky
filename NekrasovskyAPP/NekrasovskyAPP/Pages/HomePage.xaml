<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NekrasovskyAPP.Pages.HomePage"
             BackgroundColor="{StaticResource BackgroundDark}">
    
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Выход" Clicked="OnLogoutClicked" />
    </ContentPage.ToolbarItems>
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <!-- Header -->
            <Label Text="Система управления складом"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{StaticResource White}"
                   HorizontalOptions="Center"
                   Margin="0,10,0,30" />

            <StackLayout Padding="10,5">
                <Label Text="{Binding CurrentUserName}"
                    FontSize="12"
                    TextColor="{StaticResource Gray400}"
                    HorizontalOptions="End"
                    Margin="0,0,10,0" />
            </StackLayout>
            
            <!-- Navigation Cards -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="*,*,*,*" ColumnSpacing="15" RowSpacing="15">
                
                <!-- Scanner Card -->
                <Border Grid.Row="0" Grid.Column="0"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="1"
                        Stroke="{StaticResource BorderColor}"
                        Padding="20"
                        Margin="0,0,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="📷" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Сканер"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center" />
                        <Button Text="Сканировать"
                                Clicked="OnScannerClicked"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                CornerRadius="10" />
                    </VerticalStackLayout>
                </Border>
                
                <!-- Products Card -->
                <Border Grid.Row="0" Grid.Column="1"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="1"
                        Stroke="{StaticResource BorderColor}"
                        Padding="20"
                        Margin="0,0,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="📦" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Продукты" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center" />
                        <Button Text="Открыть"
                                Clicked="OnProductsClicked"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                CornerRadius="10" />
                    </VerticalStackLayout>
                </Border>
                
                <!-- Materials Card -->
                <Border Grid.Row="1" Grid.Column="0"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="1"
                        Stroke="{StaticResource BorderColor}"
                        Padding="20"
                        Margin="0,0,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="🔧" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Материалы" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center" />
                        <Button Text="Открыть"
                                Clicked="OnMaterialsClicked"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                CornerRadius="10" />
                    </VerticalStackLayout>
                </Border>
                
                <!-- Warehouses Card -->
                <Border Grid.Row="1" Grid.Column="1"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="1"
                        Stroke="{StaticResource BorderColor}"
                        Padding="20"
                        Margin="0,0,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="🏭" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Склады" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center" />
                        <Button Text="Открыть"
                                Clicked="OnWarehousesClicked"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                CornerRadius="10" />
                    </VerticalStackLayout>
                </Border>
                
                <!-- Work Reports Card -->
                <Border Grid.Row="2" Grid.Column="0"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="1"
                        Stroke="{StaticResource BorderColor}"
                        Padding="20"
                        Margin="0,0,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="📊" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Отчеты" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center" />
                        <Button Text="Открыть"
                                Clicked="OnWorkReportsClicked"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                CornerRadius="10" />
                    </VerticalStackLayout>
                </Border>
                
                <!-- Part Requests Card -->
                <Border Grid.Row="2" Grid.Column="1"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="1"
                        Stroke="{StaticResource BorderColor}"
                        Padding="20"
                        Margin="0,0,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="📋" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Запросы" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center" />
                        <Button Text="Открыть"
                                Clicked="OnPartRequestsClicked"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                CornerRadius="10" />
                    </VerticalStackLayout>
                </Border>

                <!-- Shift Transfers Card -->
                <Border Grid.Row="3" Grid.Column="0"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="1"
                        Stroke="{StaticResource BorderColor}"
                        Padding="20"
                        Margin="0,0,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="🔄" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Передача смены" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center" />
                        <Button Text="Открыть"
                                Clicked="OnShiftTransfersClicked"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                CornerRadius="10" />
                    </VerticalStackLayout>
                </Border>
                
            </Grid>
            
            <!-- Alarm Button -->
            <Border Margin="0,20,0,0"
                    BackgroundColor="#DC3545"
                    StrokeThickness="2"
                    Stroke="#FF6B6B"
                    Padding="25"
                    HorizontalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Button x:Name="AlarmButton"
                        Text="🚨 ТРЕВОГА"
                        FontSize="24"
                        FontAttributes="Bold"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource White}"
                        BorderColor="Transparent"
                        BorderWidth="0"
                        Clicked="OnAlarmClicked"
                        HorizontalOptions="Fill"
                        HeightRequest="80" />
            </Border>
            
        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>
