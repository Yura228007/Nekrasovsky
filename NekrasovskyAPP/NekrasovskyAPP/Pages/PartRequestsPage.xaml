<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:NekrasovskyAPP.Converters"
             x:Class="NekrasovskyAPP.Pages.PartRequestsPage"
             Title="Запросы на детали"
             BackgroundColor="{StaticResource BackgroundDark}">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:IsStringNotEmptyConverter x:Key="IsStringNotEmpty" />
            <converters:IsPendingConverter x:Key="IsPendingConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Обновить" Clicked="OnRefreshClicked" />
        <ToolbarItem Text="Создать запрос" Clicked="OnAddClicked" />
    </ContentPage.ToolbarItems>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Part Requests Lists -->
        <RefreshView Grid.Row="0" 
                     IsRefreshing="{Binding IsLoading}"
                     Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Входящие запросы"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}"
                           Margin="15,10,15,0" />
                    <CollectionView ItemsSource="{Binding IncomingRequests}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{StaticResource BackgroundCard}"
                                        StrokeThickness="1"
                                        Stroke="{StaticResource BorderColor}"
                                        Margin="15,8"
                                        Padding="18">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding MaterialId, StringFormat='Материал ID: {0}'}"
                                               FontSize="14"
                                               TextColor="{StaticResource Gray400}" />
                                        <Label Text="{Binding Quantity, StringFormat='Количество: {0}'}"
                                               FontSize="14"
                                               TextColor="{StaticResource Gray400}" />
                                        <Label Text="{Binding Status, StringFormat='Статус: {0}'}"
                                               FontSize="14"
                                               TextColor="{StaticResource Gray400}" />
                                        <Label Text="{Binding CreatedAt, StringFormat='Создан: {0:dd.MM.yyyy HH:mm}'}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray600}" />
                                        <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">
                                            <Button Text="Одобрить"
                                                    Clicked="OnApproveClicked"
                                                    BackgroundColor="{StaticResource Success}"
                                                    TextColor="{StaticResource White}"
                                                    CornerRadius="8"
                                                    IsVisible="{Binding Status, Converter={StaticResource IsPendingConverter}}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Text="Отклонить"
                                                    Clicked="OnRejectClicked"
                                                    BackgroundColor="{StaticResource Error}"
                                                    TextColor="{StaticResource White}"
                                                    CornerRadius="8"
                                                    IsVisible="{Binding Status, Converter={StaticResource IsPendingConverter}}"
                                                    CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Text="Отправленные запросы"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}"
                           Margin="15,10,15,0" />
                    <CollectionView ItemsSource="{Binding SentRequests}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{StaticResource BackgroundCard}"
                                        StrokeThickness="1"
                                        Stroke="{StaticResource BorderColor}"
                                        Margin="15,8"
                                        Padding="18">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding MaterialId, StringFormat='Материал ID: {0}'}"
                                               FontSize="14"
                                               TextColor="{StaticResource Gray400}" />
                                        <Label Text="{Binding Quantity, StringFormat='Количество: {0}'}"
                                               FontSize="14"
                                               TextColor="{StaticResource Gray400}" />
                                        <Label Text="{Binding Status, StringFormat='Статус: {0}'}"
                                               FontSize="14"
                                               TextColor="{StaticResource Gray400}" />
                                        <Label Text="{Binding CreatedAt, StringFormat='Создан: {0:dd.MM.yyyy HH:mm}'}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray600}" />
                                        <Button Text="Отменить"
                                                Clicked="OnCancelClicked"
                                                BackgroundColor="{StaticResource Error}"
                                                TextColor="{StaticResource White}"
                                                CornerRadius="8"
                                                IsVisible="{Binding Status, Converter={StaticResource IsPendingConverter}}"
                                                CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        
        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="0"
                          IsRunning="{Binding IsLoading}"
                          IsVisible="{Binding IsLoading}"
                          Color="{StaticResource Accent}"
                          VerticalOptions="Center"
                          HorizontalOptions="Center" />
        
        <!-- Error Message -->
        <Label Grid.Row="1"
               Text="{Binding ErrorMessage}"
               TextColor="{StaticResource Error}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotEmpty}}"
               Margin="15"
               HorizontalOptions="Center" />
    </Grid>
    
</ContentPage>
