<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NekrasovskyAPP.Pages.HistoryPage"
             BackgroundColor="{StaticResource BackgroundDark}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Обновить" Clicked="OnRefreshClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,4,0,12">
            <VerticalStackLayout>
                <Label Text="История действий"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource White}" />
                <Label Text="Журнал всех операций"
                       FontSize="12"
                       TextColor="{StaticResource Gray500}" />
            </VerticalStackLayout>
            <Border Grid.Column="1"
                    BackgroundColor="{StaticResource CardShift}"
                    WidthRequest="44"
                    HeightRequest="44"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Label Text="📜" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
        </Grid>

        <!-- Компактная панель фильтров -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource BackgroundCard}"
                StrokeThickness="0"
                Padding="12"
                Margin="0,0,0,12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16"/>
            </Border.StrokeShape>
            <FlexLayout Wrap="Wrap"
                        JustifyContent="Start"
                        AlignItems="Center">

                <!-- Поиск -->
                <Border BackgroundColor="{StaticResource BackgroundInput}"
                        StrokeThickness="0"
                        Padding="8,0"
                        Margin="4"
                        HeightRequest="{OnIdiom Phone=40, Tablet=44, Desktop=58}"
                        FlexLayout.Basis="{OnIdiom Desktop=24%, Phone=Auto, Tablet=Auto}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Text="🔍" FontSize="14" VerticalOptions="Center" Margin="0,0,6,0"/>
                        <Entry Grid.Column="1"
                               x:Name="SearchEntry"
                               Text="{Binding SearchText}"
                               Placeholder="Поиск..."
                               PlaceholderColor="{StaticResource Gray600}"
                               TextColor="{StaticResource White}"
                               BackgroundColor="Transparent"
                               FontSize="13"
                               VerticalOptions="Center"
                               Completed="OnSearchCompleted" />
                    </Grid>
                </Border>

                <!-- Пользователь -->
                <Border BackgroundColor="{StaticResource BackgroundInput}"
                        StrokeThickness="0"
                        Padding="8,0"
                        Margin="4"
                        HeightRequest="{OnIdiom Phone=40, Tablet=44, Desktop=58}"
                        FlexLayout.Basis="{OnIdiom Desktop=18%, Phone=Auto, Tablet=Auto}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Picker x:Name="UserPicker"
                            Title="Пользователь"
                            TitleColor="{StaticResource Gray500}"
                            TextColor="{StaticResource White}"
                            BackgroundColor="Transparent"
                            FontSize="13"
                            ItemsSource="{Binding Users}"
                            SelectedItem="{Binding SelectedUser}"
                            ItemDisplayBinding="{Binding FullName}" />
                </Border>

                <!-- Продукт -->
                <Border BackgroundColor="{StaticResource BackgroundInput}"
                        StrokeThickness="0"
                        Padding="8,0"
                        Margin="4"
                        HeightRequest="{OnIdiom Phone=40, Tablet=44, Desktop=58}"
                        FlexLayout.Basis="{OnIdiom Desktop=18%, Phone=Auto, Tablet=Auto}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Picker x:Name="ProductPicker"
                            Title="Продукт"
                            TitleColor="{StaticResource Gray500}"
                            TextColor="{StaticResource White}"
                            BackgroundColor="Transparent"
                            FontSize="13"
                            ItemsSource="{Binding Products}"
                            SelectedItem="{Binding SelectedProduct}"
                            ItemDisplayBinding="{Binding Name}" />
                </Border>

                <!-- Материал -->
                <Border BackgroundColor="{StaticResource BackgroundInput}"
                        StrokeThickness="0"
                        Padding="8,0"
                        Margin="4"
                        HeightRequest="{OnIdiom Phone=40, Tablet=44, Desktop=58}"
                        FlexLayout.Basis="{OnIdiom Desktop=18%, Phone=Auto, Tablet=Auto}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Picker x:Name="MaterialPicker"
                            Title="Материал"
                            TitleColor="{StaticResource Gray500}"
                            TextColor="{StaticResource White}"
                            BackgroundColor="Transparent"
                            FontSize="13"
                            ItemsSource="{Binding Materials}"
                            SelectedItem="{Binding SelectedMaterial}"
                            ItemDisplayBinding="{Binding Name}" />
                </Border>

                <!-- Склад -->
                <Border BackgroundColor="{StaticResource BackgroundInput}"
                        StrokeThickness="0"
                        Padding="8,0"
                        Margin="4"
                        HeightRequest="{OnIdiom Phone=40, Tablet=44, Desktop=58}"
                        FlexLayout.Basis="{OnIdiom Desktop=16%, Phone=Auto, Tablet=Auto}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Picker x:Name="WarehousePicker"
                            Title="Склад"
                            TitleColor="{StaticResource Gray500}"
                            TextColor="{StaticResource White}"
                            BackgroundColor="Transparent"
                            FontSize="13"
                            ItemsSource="{Binding Warehouses}"
                            SelectedItem="{Binding SelectedWarehouse}"
                            ItemDisplayBinding="{Binding Name}" />
                </Border>

                <!-- Сброс -->
                <Border BackgroundColor="{StaticResource Error}"
                        StrokeThickness="0"
                        HeightRequest="{OnIdiom Phone=40, Tablet=44, Desktop=58}"
                        Margin="4"
                        FlexLayout.Basis="{OnIdiom Desktop=6%, Phone=Auto, Tablet=Auto}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnResetFiltersClicked"/>
                    </Border.GestureRecognizers>
                    <Label Text="✕"
                           TextColor="{StaticResource White}"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
            </FlexLayout>
        </Border>

        <!-- Список событий -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Events}">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                    <Border BackgroundColor="{StaticResource BackgroundCard}"
                            WidthRequest="80"
                            HeightRequest="80"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Label Text="📭" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Text="История пуста"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray400}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Здесь будут отображаться действия"
                           FontSize="13"
                           TextColor="{StaticResource Gray500}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="{StaticResource BackgroundCard}"
                            StrokeThickness="0"
                            Margin="0,0,0,8"
                            Padding="14">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource BackgroundElevated}"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    StrokeThickness="0"
                                    VerticalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                    <Label Text="{Binding DisplayTime}"
                                           FontSize="10"
                                           TextColor="{StaticResource Gray400}"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding DisplayDescription}"
                                       FontSize="14"
                                       TextColor="{StaticResource White}"
                                       LineBreakMode="WordWrap" />
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding ActorDisplay}"
                                           FontSize="12"
                                           TextColor="{StaticResource Primary}" />
                                    <Label Text="•"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray600}" />
                                    <Label Text="{Binding Action}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Error Message -->
        <Border Grid.Row="3"
                BackgroundColor="#33EF4444"
                StrokeThickness="0"
                Padding="12,8"
                Margin="0,8,0,0"
                IsVisible="{Binding HasError}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8"/>
            </Border.StrokeShape>
            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource Error}"
                   FontSize="13"
                   HorizontalTextAlignment="Center" />
        </Border>
    </Grid>
</ContentPage>
