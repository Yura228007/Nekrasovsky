<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:NekrasovskyAPP.Converters"
             x:Class="NekrasovskyAPP.Pages.WarehousesPage"
             BackgroundColor="{StaticResource BackgroundDark}">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToStatusTextConverter x:Key="BoolToStatusTextConverter" />
            <converters:BoolToStatusColorConverter x:Key="BoolToStatusColorConverter" />
            <converters:WarehouseTypeToIconConverter x:Key="WarehouseTypeToIconConverter" />
            <converters:WarehouseTypeToColorConverter x:Key="WarehouseTypeToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Обновить" Clicked="OnRefreshClicked" />
        <ToolbarItem x:Name="AddToolbarItem" Text="Добавить" Clicked="OnAddClicked" />
    </ContentPage.ToolbarItems>
    
    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,4,0,12">
            <VerticalStackLayout>
                <Label Text="Склады"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource White}" />
                <Label Text="Управление складами"
                       FontSize="12"
                       TextColor="{StaticResource Gray500}" />
            </VerticalStackLayout>
            <Border Grid.Column="1"
                    BackgroundColor="{StaticResource CardWarehouses}"
                    WidthRequest="44"
                    HeightRequest="44"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Label Text="🏭" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
        </Grid>

        <!-- Search Bar -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource BackgroundCard}"
                StrokeThickness="0"
                Padding="0"
                HeightRequest="48"
                Margin="0,0,0,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="48,*" VerticalOptions="Center">
                <Label Text="🔍"
                       FontSize="18"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                <Entry Grid.Column="1"
                       x:Name="SearchEntry"
                       Placeholder="Поиск по названию или типу..."
                       TextChanged="OnSearchTextChanged"
                       TextColor="{StaticResource White}"
                       PlaceholderColor="{StaticResource Gray600}"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Filter Panel -->
        <Border Grid.Row="2"
                BackgroundColor="{StaticResource BackgroundCard}"
                StrokeThickness="0"
                Padding="12"
                Margin="0,0,0,12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <!-- Фильтр по типу -->
                <Border Grid.Column="0"
                        BackgroundColor="{StaticResource BackgroundInput}"
                        StrokeThickness="0"
                        Padding="6,0"
                        HeightRequest="40">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Picker x:Name="TypePicker"
                            Title="Тип"
                            SelectedIndexChanged="OnFilterChanged"
                            TextColor="{StaticResource White}"
                            TitleColor="{StaticResource Gray500}"
                            FontSize="12">
                        <Picker.Items>
                            <x:String>Все</x:String>
                            <x:String>Цех</x:String>
                            <x:String>Склад</x:String>
                            <x:String>Производство</x:String>
                            <x:String>Утиль</x:String>
                        </Picker.Items>
                    </Picker>
                </Border>

                <!-- Фильтр по статусу -->
                <Border Grid.Column="1"
                        BackgroundColor="{StaticResource BackgroundInput}"
                        StrokeThickness="0"
                        Padding="6,0"
                        HeightRequest="40">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Picker x:Name="StatusPicker"
                            Title="Статус"
                            SelectedIndexChanged="OnFilterChanged"
                            TextColor="{StaticResource White}"
                            TitleColor="{StaticResource Gray500}"
                            FontSize="12">
                        <Picker.Items>
                            <x:String>Все</x:String>
                            <x:String>Активные</x:String>
                            <x:String>Остановлены</x:String>
                        </Picker.Items>
                    </Picker>
                </Border>

                <!-- Сортировка -->
                <Border Grid.Column="2"
                        BackgroundColor="{StaticResource BackgroundInput}"
                        StrokeThickness="0"
                        Padding="6,0"
                        HeightRequest="40">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Picker x:Name="SortPicker"
                            Title="Сортировка"
                            SelectedIndexChanged="OnFilterChanged"
                            TextColor="{StaticResource White}"
                            TitleColor="{StaticResource Gray500}"
                            FontSize="12">
                        <Picker.Items>
                            <x:String>По имени ↑</x:String>
                            <x:String>По имени ↓</x:String>
                            <x:String>По типу ↑</x:String>
                            <x:String>По типу ↓</x:String>
                        </Picker.Items>
                    </Picker>
                </Border>
            </Grid>
        </Border>

        <!-- Warehouses List -->
        <RefreshView Grid.Row="3"
                     IsRefreshing="{Binding IsLoading}"
                     Refreshing="OnRefreshing">
            <CollectionView x:Name="WarehousesCollectionView"
                            ItemsSource="{Binding Warehouses}"
                            SelectionMode="Single"
                            SelectionChanged="OnWarehouseSelected">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="12">
                        <Border BackgroundColor="{StaticResource BackgroundCard}"
                                WidthRequest="80"
                                HeightRequest="80"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20"/>
                            </Border.StrokeShape>
                            <Label Text="📭" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Склады не найдены"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray400}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{StaticResource BackgroundCard}"
                                StrokeThickness="0"
                                Margin="0,0,0,10"
                                Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Border Grid.Column="0"
                                        BackgroundColor="{Binding Type, Converter={StaticResource WarehouseTypeToColorConverter}}"
                                        WidthRequest="48"
                                        HeightRequest="48"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Type, Converter={StaticResource WarehouseTypeToIconConverter}}" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding Name}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource White}" />
                                    <Label Text="{Binding Type, StringFormat='Тип: {0}'}"
                                           FontSize="13"
                                           TextColor="{StaticResource Gray400}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2"
                                        BackgroundColor="{Binding IsActive, Converter={StaticResource BoolToStatusColorConverter}}"
                                        StrokeThickness="0"
                                        Padding="10,6"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8"/>
                                    </Border.StrokeShape>
                                    <Label Text="{Binding IsActive, Converter={StaticResource BoolToStatusTextConverter}}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource White}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="3"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource Primary}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />
    </Grid>
    
</ContentPage>
