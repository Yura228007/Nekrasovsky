<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:NekrasovskyAPP.Converters"
             x:Class="NekrasovskyAPP.Pages.UsersPage"
             BackgroundColor="{StaticResource BackgroundDark}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:IsStringNotEmptyConverter x:Key="IsStringNotEmpty" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Обновить" Clicked="OnRefreshClicked" />
        <ToolbarItem Text="Добавить" Clicked="OnAddClicked" />
    </ContentPage.ToolbarItems>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <Border Grid.Row="0" 
                BackgroundColor="{StaticResource BackgroundCard}"
                StrokeThickness="1"
                Stroke="{StaticResource BorderColor}"
                Padding="15,12"
                Margin="15,15,15,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>
            <Entry x:Name="SearchEntry"
                   Placeholder="Поиск по имени или фамилии..."
                   TextChanged="OnSearchTextChanged"
                   TextColor="{StaticResource Gray200}"
                   PlaceholderColor="{StaticResource Gray600}"
                   BackgroundColor="Transparent" />
        </Border>

        <!-- Users List -->
        <RefreshView Grid.Row="1" 
                     IsRefreshing="{Binding IsLoading}"
                     Refreshing="OnRefreshing">
            <CollectionView x:Name="UsersCollectionView"
                            ItemsSource="{Binding Users}"
                            SelectionMode="Single"
                            SelectionChanged="OnUserSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{StaticResource BackgroundCard}"
                                StrokeThickness="1"
                                Stroke="{StaticResource BorderColor}"
                                Margin="15,8"
                                Padding="18">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                                <Label Grid.Row="0" Grid.Column="0"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource White}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Name}" />
                                            <Span Text=" " />
                                            <Span Text="{Binding Surname}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding Email}"
                                       FontSize="14"
                                       TextColor="{StaticResource Gray400}"
                                       Margin="0,5,0,0" />
                                <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding Login, StringFormat='Логин: {0}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray600}"
                                       Margin="0,3,0,0" />
                                <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}"
                                       Margin="0,5,0,0">
                                    <Label.Text>
                                        <Binding Path="Role.Name">
                                            <Binding.StringFormat>Роль: {0}</Binding.StringFormat>
                                            <Binding.FallbackValue>Роль: Не назначена</Binding.FallbackValue>
                                        </Binding>
                                    </Label.Text>
                                </Label>
                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="→"
                                       FontSize="20"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource Gray500}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource Accent}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

        <!-- Error Message -->
        <Label Grid.Row="2"
               Text="{Binding ErrorMessage}"
               TextColor="{StaticResource Error}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotEmpty}}"
               Margin="15"
               HorizontalOptions="Center" />
    </Grid>

</ContentPage>
