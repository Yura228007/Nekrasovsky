<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NekrasovskyAPP.Pages.SettingsPage"
             BackgroundColor="{StaticResource BackgroundDark}">
    
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,12">
                <VerticalStackLayout>
                    <Label Text="Настройки"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}" />
                    <Label Text="Параметры системы"
                           FontSize="12"
                           TextColor="{StaticResource Gray500}" />
                </VerticalStackLayout>
                <Border Grid.Column="1"
                        BackgroundColor="{StaticResource Gray700}"
                        WidthRequest="44"
                        HeightRequest="44"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Label Text="⚙️" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </Grid>

            <!-- Database Info Section -->
            <Border BackgroundColor="{StaticResource BackgroundCard}"
                    StrokeThickness="0"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="16">
                    <HorizontalStackLayout Spacing="12">
                        <Border BackgroundColor="{StaticResource CardReports}"
                                WidthRequest="44"
                                HeightRequest="44"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label Text="📊" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="База данных"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource White}" />
                            <Label Text="Состояние подключения"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray500}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <Label x:Name="DatabaseStatusLabel"
                           Text=""
                           FontSize="14"
                           TextColor="{StaticResource Gray400}" />
                    <Button Text="Проверить подключение"
                            Clicked="OnCheckDatabaseClicked"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource White}"
                            CornerRadius="12"
                            HeightRequest="44" />
                </VerticalStackLayout>
            </Border>

            <!-- System Info Section -->
            <Border BackgroundColor="{StaticResource BackgroundCard}"
                    StrokeThickness="0"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="16">
                    <HorizontalStackLayout Spacing="12">
                        <Border BackgroundColor="{StaticResource Info}"
                                WidthRequest="44"
                                HeightRequest="44"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label Text="ℹ️" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Информация о системе"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource White}" />
                            <Label Text="Версия и статистика"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray500}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <Label x:Name="SystemInfoLabel"
                           Text=""
                           FontSize="14"
                           TextColor="{StaticResource Gray400}" />
                    <Button Text="Обновить информацию"
                            Clicked="OnRefreshInfoClicked"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource White}"
                            CornerRadius="12"
                            HeightRequest="44" />
                </VerticalStackLayout>
            </Border>

            <!-- API Configuration Section -->
            <Border BackgroundColor="{StaticResource BackgroundCard}"
                    StrokeThickness="0"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="16">
                    <HorizontalStackLayout Spacing="12">
                        <Border BackgroundColor="{StaticResource CardMaterials}"
                                WidthRequest="44"
                                HeightRequest="44"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label Text="🔧" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Настройки API"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource White}" />
                            <Label Text="Конфигурация сервера"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray500}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <Border BackgroundColor="{StaticResource BackgroundInput}"
                            StrokeThickness="0"
                            Padding="12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Label x:Name="ApiUrlLabel"
                               Text=""
                               FontSize="13"
                               TextColor="{StaticResource Gray400}" />
                    </Border>
                    <Label Text="Для изменения URL отредактируйте файл server_ip.txt"
                           FontSize="12"
                           TextColor="{StaticResource Gray600}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>
