<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Modern Dark Theme - Vibrant and Clean -->
    <Color x:Key="Primary">#6366F1</Color>
    <Color x:Key="PrimaryDark">#4F46E5</Color>
    <Color x:Key="PrimaryLight">#818CF8</Color>
    <Color x:Key="Secondary">#8B5CF6</Color>
    <Color x:Key="Tertiary">#0F172A</Color>

    <!-- Base Colors -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

    <!-- Dark Backgrounds - Softer -->
    <Color x:Key="BackgroundDark">#0D0D12</Color>
    <Color x:Key="BackgroundCard">#16161D</Color>
    <Color x:Key="BackgroundElevated">#1C1C26</Color>
    <Color x:Key="BackgroundHover">#252532</Color>
    <Color x:Key="BackgroundInput">#12121A</Color>

    <!-- Gray Scale - Modern -->
    <Color x:Key="Gray50">#FAFAFA</Color>
    <Color x:Key="Gray100">#F4F4F5</Color>
    <Color x:Key="Gray200">#E4E4E7</Color>
    <Color x:Key="Gray300">#D4D4D8</Color>
    <Color x:Key="Gray400">#A1A1AA</Color>
    <Color x:Key="Gray500">#71717A</Color>
    <Color x:Key="Gray600">#52525B</Color>
    <Color x:Key="Gray700">#3F3F46</Color>
    <Color x:Key="Gray800">#27272A</Color>
    <Color x:Key="Gray900">#18181B</Color>

    <!-- Accent Colors - Vibrant -->
    <Color x:Key="Accent">#3B82F6</Color>
    <Color x:Key="AccentDark">#2563EB</Color>
    <Color x:Key="AccentLight">#60A5FA</Color>
    <Color x:Key="Success">#22C55E</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="Error">#EF4444</Color>
    <Color x:Key="Info">#06B6D4</Color>

    <!-- Card Accent Colors for different sections -->
    <Color x:Key="CardScanner">#3B82F6</Color>
    <Color x:Key="CardProducts">#8B5CF6</Color>
    <Color x:Key="CardMaterials">#F59E0B</Color>
    <Color x:Key="CardWarehouses">#22C55E</Color>
    <Color x:Key="CardReports">#06B6D4</Color>
    <Color x:Key="CardRequests">#EC4899</Color>
    <Color x:Key="CardShift">#14B8A6</Color>
    <Color x:Key="CardReprocess">#84CC16</Color>
    <Color x:Key="CardMixing">#A855F7</Color>
    <Color x:Key="CardDisposal">#F43F5E</Color>

    <!-- Borders -->
    <Color x:Key="BorderColor">#252532</Color>
    <Color x:Key="BorderColorLight">#353545</Color>
    <Color x:Key="DividerColor">#1C1C26</Color>
    
    <!-- Кисти для основных цветов -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLight}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    
    <!-- Кисти для фонов -->
    <SolidColorBrush x:Key="BackgroundDarkBrush" Color="{StaticResource BackgroundDark}"/>
    <SolidColorBrush x:Key="BackgroundCardBrush" Color="{StaticResource BackgroundCard}"/>
    <SolidColorBrush x:Key="BackgroundElevatedBrush" Color="{StaticResource BackgroundElevated}"/>
    <SolidColorBrush x:Key="BackgroundHoverBrush" Color="{StaticResource BackgroundHover}"/>
    
    <!-- Кисти для серых оттенков -->
    <SolidColorBrush x:Key="Gray50Brush" Color="{StaticResource Gray50}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray700Brush" Color="{StaticResource Gray700}"/>
    <SolidColorBrush x:Key="Gray800Brush" Color="{StaticResource Gray800}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    
    <!-- Кисти для акцентов -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDark}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}"/>
    
    <!-- Кисти для границ -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>

</ResourceDictionary>
