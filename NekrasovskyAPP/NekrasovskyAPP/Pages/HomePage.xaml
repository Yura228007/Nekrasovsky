<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NekrasovskyAPP.Pages.HomePage"
             Title="Главная"
             BackgroundColor="{StaticResource BackgroundDark}">
    
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Выход" Clicked="OnLogoutClicked" />
    </ContentPage.ToolbarItems>
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <!-- Header -->
            <Label Text="Система управления складом"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{StaticResource White}"
                   HorizontalOptions="Center"
                   Margin="0,10,0,30" />
            
            <!-- Navigation Cards -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="*,*,*" ColumnSpacing="15" RowSpacing="15">
                
                <!-- Users Card -->
                <Border Grid.Row="0" Grid.Column="0"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="1"
                        Stroke="{StaticResource BorderColor}"
                        Padding="20"
                        Margin="0,0,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="👥" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Пользователи" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center" />
                        <Button Text="Открыть"
                                Clicked="OnUsersClicked"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                CornerRadius="10" />
                    </VerticalStackLayout>
                </Border>
                
                <!-- Products Card -->
                <Border Grid.Row="0" Grid.Column="1"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="1"
                        Stroke="{StaticResource BorderColor}"
                        Padding="20"
                        Margin="0,0,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="📦" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Продукты" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center" />
                        <Button Text="Открыть"
                                Clicked="OnProductsClicked"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                CornerRadius="10" />
                    </VerticalStackLayout>
                </Border>
                
                <!-- Materials Card -->
                <Border Grid.Row="1" Grid.Column="0"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="1"
                        Stroke="{StaticResource BorderColor}"
                        Padding="20"
                        Margin="0,0,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="🔧" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Материалы" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center" />
                        <Button Text="Открыть"
                                Clicked="OnMaterialsClicked"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                CornerRadius="10" />
                    </VerticalStackLayout>
                </Border>
                
                <!-- Warehouses Card -->
                <Border Grid.Row="1" Grid.Column="1"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="1"
                        Stroke="{StaticResource BorderColor}"
                        Padding="20"
                        Margin="0,0,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="🏭" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Склады" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center" />
                        <Button Text="Открыть"
                                Clicked="OnWarehousesClicked"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                CornerRadius="10" />
                    </VerticalStackLayout>
                </Border>
                
                <!-- Work Reports Card -->
                <Border Grid.Row="2" Grid.Column="0"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="1"
                        Stroke="{StaticResource BorderColor}"
                        Padding="20"
                        Margin="0,0,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="📊" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Отчеты" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center" />
                        <Button Text="Открыть"
                                Clicked="OnWorkReportsClicked"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                CornerRadius="10" />
                    </VerticalStackLayout>
                </Border>
                
                <!-- Part Requests Card -->
                <Border Grid.Row="2" Grid.Column="1"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="1"
                        Stroke="{StaticResource BorderColor}"
                        Padding="20"
                        Margin="0,0,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="📋" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Запросы" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center" />
                        <Button Text="Открыть"
                                Clicked="OnPartRequestsClicked"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                CornerRadius="10" />
                    </VerticalStackLayout>
                </Border>
                
            </Grid>
            
        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>
