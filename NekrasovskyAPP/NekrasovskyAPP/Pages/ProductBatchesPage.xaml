<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:NekrasovskyAPP.ViewModels"
             xmlns:models="clr-namespace:NekrasovskyAPP.Models"
             xmlns:converters="clr-namespace:NekrasovskyAPP.Converters"
             x:Class="NekrasovskyAPP.Pages.ProductBatchesPage"
             Title="Партии"
             BackgroundColor="{StaticResource BackgroundDark}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:IsNotNullConverter x:Key="IsNotNullConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Обновить" Clicked="OnRefreshClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,4,0,12">
            <VerticalStackLayout>
                <Label Text="Партии"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource White}" />
                <Label Text="Партии продукции"
                       FontSize="12"
                       TextColor="{StaticResource Gray500}" />
            </VerticalStackLayout>
            <Border Grid.Column="1"
                    BackgroundColor="#9b59b6"
                    WidthRequest="44"
                    HeightRequest="44"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Label Text="📦" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
        </Grid>

        <!-- Search Bar -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource BackgroundCard}"
                StrokeThickness="0"
                Padding="0"
                HeightRequest="48"
                Margin="0,0,0,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="48,*" VerticalOptions="Center">
                <Label Text="🔍"
                       FontSize="18"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                <Entry Grid.Column="1"
                       x:Name="SearchEntry"
                       Placeholder="Поиск по названию продукта или артикулу..."
                       TextChanged="OnSearchTextChanged"
                       TextColor="{StaticResource White}"
                       PlaceholderColor="{StaticResource Gray600}"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Filter Panel -->
        <Border Grid.Row="2"
                BackgroundColor="{StaticResource BackgroundCard}"
                StrokeThickness="0"
                Padding="12"
                Margin="0,0,0,12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Border Grid.Row="0" Grid.Column="0"
                        BackgroundColor="{StaticResource BackgroundInput}"
                        StrokeThickness="0"
                        Padding="8,0"
                        HeightRequest="{OnIdiom Phone=40, Tablet=44, Desktop=58}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Picker x:Name="StatusPicker"
                            Title="Статус"
                            SelectedIndexChanged="OnFilterChanged"
                            TextColor="{StaticResource White}"
                            TitleColor="{StaticResource Gray500}"
                            FontSize="13">
                        <Picker.Items>
                            <x:String>Все</x:String>
                            <x:String>Активные</x:String>
                            <x:String>Неактивные</x:String>
                        </Picker.Items>
                    </Picker>
                </Border>
                <Border Grid.Row="0" Grid.Column="1"
                        BackgroundColor="{StaticResource BackgroundInput}"
                        StrokeThickness="0"
                        Padding="8,0"
                        HeightRequest="{OnIdiom Phone=40, Tablet=44, Desktop=58}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Picker x:Name="SortPicker"
                            Title="Сортировка"
                            SelectedIndexChanged="OnFilterChanged"
                            TextColor="{StaticResource White}"
                            TitleColor="{StaticResource Gray500}"
                            FontSize="13">
                        <Picker.Items>
                            <x:String>По продукту (А-Я)</x:String>
                            <x:String>По продукту (Я-А)</x:String>
                            <x:String>По дате (новые)</x:String>
                            <x:String>По дате (старые)</x:String>
                            <x:String>По количеству</x:String>
                        </Picker.Items>
                    </Picker>
                </Border>
                <Border Grid.Row="1" Grid.Column="0"
                        BackgroundColor="{StaticResource BackgroundInput}"
                        StrokeThickness="0"
                        Padding="8,0"
                        HeightRequest="{OnIdiom Phone=40, Tablet=44, Desktop=58}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Picker x:Name="WarehousePicker"
                            Title="Склад"
                            ItemsSource="{Binding Warehouses}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedIndexChanged="OnFilterChanged"
                            TextColor="{StaticResource White}"
                            TitleColor="{StaticResource Gray500}"
                            FontSize="13"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="1"
                        BackgroundColor="{StaticResource BackgroundInput}"
                        StrokeThickness="0"
                        Padding="8,0"
                        HeightRequest="{OnIdiom Phone=40, Tablet=44, Desktop=58}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Picker x:Name="UserPicker"
                            Title="Ответственный"
                            SelectedIndexChanged="OnFilterChanged"
                            TextColor="{StaticResource White}"
                            TitleColor="{StaticResource Gray500}"
                            FontSize="13"/>
                </Border>
            </Grid>
        </Border>

        <!-- Batches List -->
        <RefreshView Grid.Row="3" IsRefreshing="{Binding IsLoading}" Refreshing="OnRefreshing">
            <CollectionView x:Name="BatchesCollectionView"
                            ItemsSource="{Binding ProductBatches}"
                            SelectionMode="Single"
                            SelectionChanged="OnBatchSelected">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="12">
                        <Border BackgroundColor="{StaticResource BackgroundCard}"
                                WidthRequest="80"
                                HeightRequest="80"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20"/>
                            </Border.StrokeShape>
                            <Label Text="📭" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Нет партий продукции"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray400}"
                               HorizontalOptions="Center" />
                        <Label Text="Попробуйте изменить фильтры"
                               FontSize="13"
                               TextColor="{StaticResource Gray500}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ProductBatch">
                        <Border BackgroundColor="{StaticResource BackgroundCard}"
                                StrokeThickness="0"
                                Margin="0,0,0,10"
                                Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding DisplayName}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource White}" />
                                <Label Text="{Binding ProductCode, StringFormat='Артикул: {0}'}"
                                       FontSize="13"
                                       TextColor="{StaticResource Gray400}"
                                       IsVisible="{Binding ProductCode, Converter={StaticResource IsNotNullConverter}}"/>
                                <HorizontalStackLayout Spacing="12">
                                    <Label Text="{Binding WarehouseDisplay, StringFormat='Склад: {0}'}"
                                           FontSize="13"
                                           TextColor="{StaticResource Gray400}" />
                                    <Label Text="{Binding QuantityDisplay}"
                                           FontSize="13"
                                           TextColor="{StaticResource Primary}" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding ResponsibleDisplay, StringFormat='Ответственный: {0}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray500}" />
                                <Label Text="{Binding CreatedAt, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray600}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator Grid.Row="3"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource Primary}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>
    </Grid>
</ContentPage>
