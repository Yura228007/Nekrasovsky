<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:NekrasovskyAPP.Converters"
             x:Class="NekrasovskyAPP.Pages.UsersPage"
             Title="Пользователи">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:IsStringNotEmptyConverter x:Key="IsStringNotEmpty" />
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Обновить" Clicked="OnRefreshClicked" />
        <ToolbarItem Text="Добавить" Clicked="OnAddClicked" />
    </ContentPage.ToolbarItems>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Search Bar -->
        <Border Grid.Row="0" 
                BackgroundColor="White"
                Padding="10"
                Margin="10,10,10,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </Border.StrokeShape>
            <Entry x:Name="SearchEntry"
                   Placeholder="Поиск по имени или фамилии..."
                   TextChanged="OnSearchTextChanged" />
        </Border>
        
        <!-- Users List -->
        <RefreshView Grid.Row="1" 
                     IsRefreshing="{Binding IsLoading}"
                     Refreshing="OnRefreshing">
            <CollectionView x:Name="UsersCollectionView"
                          ItemsSource="{Binding Users}"
                          SelectionMode="Single"
                          SelectionChanged="OnUserSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="White"
                                StrokeThickness="1"
                                Stroke="#E0E0E0"
                                Margin="10,5"
                                Padding="15">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding Name, StringFormat='{0} '}"
                                       FontSize="18"
                                       FontAttributes="Bold" />
                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding Surname}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Start" />
                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding Email}"
                                       FontSize="14"
                                       TextColor="Gray"
                                       Margin="0,5,0,0" />
                                <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding Login, StringFormat='Логин: {0}'}"
                                       FontSize="12"
                                       TextColor="DarkGray"
                                       Margin="0,5,0,0" />
                                <Label Grid.Row="0" Grid.Column="2"
                                       Text="→"
                                       FontSize="20"
                                       VerticalOptions="Center"
                                       TextColor="Gray" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        
        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="1"
                          IsRunning="{Binding IsLoading}"
                          IsVisible="{Binding IsLoading}"
                          Color="{StaticResource Primary}"
                          VerticalOptions="Center"
                          HorizontalOptions="Center" />
        
        <!-- Error Message -->
        <Label Grid.Row="2"
               Text="{Binding ErrorMessage}"
               TextColor="Red"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotEmpty}}"
               Margin="10"
               HorizontalOptions="Center" />
    </Grid>
    
</ContentPage>

