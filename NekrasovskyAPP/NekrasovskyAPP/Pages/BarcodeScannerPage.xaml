<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="NekrasovskyAPP.Pages.BarcodeScannerPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:barcode="clr-namespace:BarcodeScanning;assembly=BarcodeScanning.Native.Maui"
             Title="Сканер штрих-кодов">
    
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Label Grid.Row="0"
               Text="Наведите камеру на штрих-код или QR-код"
               FontSize="16"
               Padding="20,10"
               HorizontalOptions="Center"
               VerticalOptions="Center" />
        
        <!-- Camera View -->
        <barcode:CameraView
            x:Name="BarcodeCamera"
            Grid.Row="1"
            CameraEnabled="{Binding IsCameraEnabled}"
            OnDetectionFinishedCommand="{Binding DetectionFinishedCommand}"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />
        
        <!-- Footer with controls -->
        <Grid Grid.Row="2" 
              Padding="20"
              ColumnDefinitions="*,Auto,*">
            
            <!-- Flashlight button -->
            <Button Grid.Column="0"
                    Text="Фонарик"
                    Clicked="ToggleFlashlight"
                    HorizontalOptions="Start"
                    WidthRequest="150" />
            
            <Switch x:Name="FlashlightToggle"
                    Grid.Column="1"
                    Toggled="OnFlashlightToggled"
                    HorizontalOptions="Center" />
            
            <!-- Close button -->
            <Button Grid.Column="2"
                    Text="Закрыть"
                    Clicked="CloseScanner"
                    HorizontalOptions="End"
                    WidthRequest="100" />
        </Grid>
    </Grid>
</ContentPage>

