<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:NekrasovskyAPP.Converters"
             x:Class="NekrasovskyAPP.Pages.UsersPage"
             BackgroundColor="{StaticResource BackgroundDark}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:IsStringNotEmptyConverter x:Key="IsStringNotEmpty" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Обновить" Clicked="OnRefreshClicked" />
        <ToolbarItem Text="Добавить" Clicked="OnAddClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,4,0,12">
            <VerticalStackLayout>
                <Label Text="Пользователи"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource White}" />
                <Label Text="Управление аккаунтами"
                       FontSize="12"
                       TextColor="{StaticResource Gray500}" />
            </VerticalStackLayout>
            <Border Grid.Column="1"
                    BackgroundColor="{StaticResource Primary}"
                    WidthRequest="44"
                    HeightRequest="44"
                    StrokeThickness="0"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Label Text="👥" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>
        </Grid>

        <!-- Search Bar -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource BackgroundCard}"
                StrokeThickness="0"
                Padding="0"
                HeightRequest="48"
                Margin="0,0,0,12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="48,*" VerticalOptions="Center">
                <Label Text="🔍"
                       FontSize="18"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                <Entry Grid.Column="1"
                       x:Name="SearchEntry"
                       Placeholder="Поиск по имени или фамилии..."
                       TextChanged="OnSearchTextChanged"
                       TextColor="{StaticResource White}"
                       PlaceholderColor="{StaticResource Gray600}"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Users List -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsLoading}"
                     Refreshing="OnRefreshing">
            <CollectionView x:Name="UsersCollectionView"
                            ItemsSource="{Binding Users}"
                            SelectionMode="Single"
                            SelectionChanged="OnUserSelected">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="12">
                        <Border BackgroundColor="{StaticResource BackgroundCard}"
                                WidthRequest="80"
                                HeightRequest="80"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20"/>
                            </Border.StrokeShape>
                            <Label Text="📭" FontSize="36" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Пользователи не найдены"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray400}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{StaticResource BackgroundCard}"
                                StrokeThickness="0"
                                Margin="0,0,0,10"
                                Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Border Grid.Column="0"
                                        BackgroundColor="{StaticResource BackgroundElevated}"
                                        WidthRequest="48"
                                        HeightRequest="48"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="24"/>
                                    </Border.StrokeShape>
                                    <Label Text="👤" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource White}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Name}" />
                                                <Span Text=" " />
                                                <Span Text="{Binding Surname}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Text="{Binding Email}"
                                           FontSize="13"
                                           TextColor="{StaticResource Gray400}" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding Login}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray500}" />
                                        <Label Text="•"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray600}" />
                                        <Label FontSize="12"
                                               TextColor="{StaticResource Primary}">
                                            <Label.Text>
                                                <Binding Path="Role.Name">
                                                    <Binding.FallbackValue>Без роли</Binding.FallbackValue>
                                                </Binding>
                                            </Label.Text>
                                        </Label>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       Text="›"
                                       FontSize="24"
                                       VerticalOptions="Center"
                                       TextColor="{StaticResource Gray500}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="2"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource Primary}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

        <!-- Error Message -->
        <Border Grid.Row="3"
                BackgroundColor="#33EF4444"
                StrokeThickness="0"
                Padding="12,8"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotEmpty}}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8"/>
            </Border.StrokeShape>
            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource Error}"
                   FontSize="13"
                   HorizontalTextAlignment="Center" />
        </Border>
    </Grid>

</ContentPage>
