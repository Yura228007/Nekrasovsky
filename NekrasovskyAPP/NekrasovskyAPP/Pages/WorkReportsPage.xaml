<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:NekrasovskyAPP.Converters"
             x:Class="NekrasovskyAPP.Pages.WorkReportsPage"
             Title="Отчеты о работе"
             BackgroundColor="{StaticResource BackgroundDark}">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:IsStringNotEmptyConverter x:Key="IsStringNotEmpty" />
            <converters:IsNullConverter x:Key="IsNullConverter" />
            <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Обновить" Clicked="OnRefreshClicked" />
        <ToolbarItem Text="Начать работу" Clicked="OnStartWorkClicked" />
    </ContentPage.ToolbarItems>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Work Reports List -->
        <RefreshView Grid.Row="0" 
                     IsRefreshing="{Binding IsLoading}"
                     Refreshing="OnRefreshing">
            <CollectionView x:Name="WorkReportsCollectionView"
                          ItemsSource="{Binding WorkReports}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{StaticResource BackgroundCard}"
                                StrokeThickness="1"
                                Stroke="{StaticResource BorderColor}"
                                Margin="15,8"
                                Padding="18">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Date, StringFormat='Дата: {0:dd.MM.yyyy}'}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource White}" />
                                <Label Text="{Binding StartWork, StringFormat='Начало: {0:HH:mm}'}"
                                       FontSize="14"
                                       TextColor="{StaticResource Gray400}" />
                                <Label Text="{Binding FinishWork, StringFormat='Окончание: {0:HH:mm}'}"
                                       FontSize="14"
                                       TextColor="{StaticResource Gray400}"
                                       IsVisible="{Binding FinishWork, Converter={StaticResource IsNotNullConverter}}" />
                                <Label Text="{Binding Note, StringFormat='Примечание: {0}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray600}"
                                       IsVisible="{Binding Note, Converter={StaticResource IsStringNotEmpty}}" />
                                <Button Text="Завершить работу"
                                        Clicked="OnFinishWorkClicked"
                                        BackgroundColor="{StaticResource Warning}"
                                        TextColor="{StaticResource White}"
                                        CornerRadius="8"
                                        Margin="0,10,0,0"
                                        IsVisible="{Binding FinishWork, Converter={StaticResource IsNullConverter}}"
                                        CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        
        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="0"
                          IsRunning="{Binding IsLoading}"
                          IsVisible="{Binding IsLoading}"
                          Color="{StaticResource Accent}"
                          VerticalOptions="Center"
                          HorizontalOptions="Center" />
        
        <!-- Error Message -->
        <Label Grid.Row="1"
               Text="{Binding ErrorMessage}"
               TextColor="{StaticResource Error}"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotEmpty}}"
               Margin="15"
               HorizontalOptions="Center" />
    </Grid>
    
</ContentPage>
