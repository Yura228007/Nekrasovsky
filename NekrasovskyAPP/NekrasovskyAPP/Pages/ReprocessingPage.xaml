<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:NekrasovskyAPP.Converters"
             x:Class="NekrasovskyAPP.Pages.ReprocessingPage"
             BackgroundColor="{StaticResource BackgroundDark}"
             Title="Переработать">
    <ContentPage.Resources>
        <converters:IsStringNotEmptyConverter x:Key="IsStringNotEmptyConverter" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Обновить" Clicked="OnRefreshClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,12">
                <VerticalStackLayout>
                    <Label Text="Переработка"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}" />
                    <Label Text="Обработка материалов"
                           FontSize="12"
                           TextColor="{StaticResource Gray500}" />
                </VerticalStackLayout>
                <Border Grid.Column="1"
                        BackgroundColor="{StaticResource CardReprocess}"
                        WidthRequest="44"
                        HeightRequest="44"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Label Text="♻️" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </Grid>

            <!-- Source Section -->
            <Border BackgroundColor="{StaticResource BackgroundCard}"
                    StrokeThickness="0"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <HorizontalStackLayout Spacing="10">
                        <Border BackgroundColor="{StaticResource CardMaterials}"
                                WidthRequest="32"
                                HeightRequest="32"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Label Text="📥" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Исходные данные"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Склад"
                               FontSize="13"
                               TextColor="{StaticResource Gray400}" />
                        <Border BackgroundColor="{StaticResource BackgroundInput}"
                                StrokeThickness="0"
                                Padding="12,0"
                                x:Name="WarehousePickerBorder">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Picker x:Name="WarehousePicker"
                                    Title="Выберите склад"
                                    ItemDisplayBinding="{Binding Name}"
                                    TextColor="{StaticResource White}"
                                    TitleColor="{StaticResource Gray500}"
                                    SelectedIndexChanged="OnWarehouseSelected" />
                        </Border>
                    </VerticalStackLayout>

                    <CollectionView ItemsSource="{Binding Sources}"
                                    SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{StaticResource BackgroundCard}"
                                        StrokeThickness="0"
                                        Padding="14">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="Исходный материал"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource White}"
                                                   VerticalOptions="Center"/>
                                            <Button Grid.Column="1"
                                                    Text="Удалить"
                                                    FontSize="12"
                                                    BackgroundColor="{StaticResource Error}"
                                                    TextColor="{StaticResource White}"
                                                    CornerRadius="10"
                                                    Padding="10,4"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveSourceCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>

                                        <Border BackgroundColor="{StaticResource BackgroundInput}"
                                                StrokeThickness="0"
                                                Padding="12,0"
                                                HeightRequest="{Binding PickerHeight}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12"/>
                                            </Border.StrokeShape>
                                            <Picker Title="Выберите материал"
                                                    ItemsSource="{Binding Materials}"
                                                    SelectedItem="{Binding SelectedMaterial}"
                                                    ItemDisplayBinding="{Binding Name}"
                                                    TextColor="{StaticResource White}"
                                                    TitleColor="{StaticResource Gray500}" />
                                        </Border>

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Border Grid.Column="0"
                                                    BackgroundColor="{StaticResource BackgroundInput}"
                                                    StrokeThickness="0"
                                                    Padding="12,0"
                                                    HeightRequest="48">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12"/>
                                                </Border.StrokeShape>
                                                <Entry Keyboard="Numeric"
                                                       Placeholder="Количество"
                                                       Text="{Binding Quantity}"
                                                       TextColor="{StaticResource White}"
                                                       PlaceholderColor="{StaticResource Gray600}"
                                                       BackgroundColor="Transparent"
                                                       VerticalOptions="Center" />
                                            </Border>
                                            <Label Grid.Column="1"
                                                   Text="{Binding MeasuringUnit}"
                                                   FontSize="14"
                                                   TextColor="{StaticResource CardMaterials}"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding MeasuringUnit, Converter={StaticResource IsStringNotEmptyConverter}}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Text="Добавить исходный материал"
                            BackgroundColor="{StaticResource CardMaterials}"
                            TextColor="{StaticResource White}"
                            CornerRadius="12"
                            FontSize="14"
                            HeightRequest="42"
                            Command="{Binding AddSourceCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Outputs Section -->
            <Border BackgroundColor="{StaticResource BackgroundCard}"
                    StrokeThickness="0"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="10">
                        <Border BackgroundColor="{StaticResource CardReprocess}"
                                WidthRequest="32"
                                HeightRequest="32"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Label Text="✅" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Результаты"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <CollectionView ItemsSource="{Binding Outputs}"
                                    SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{StaticResource BackgroundCard}"
                                        StrokeThickness="0"
                                        Padding="14">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="Результат"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource White}"
                                                   VerticalOptions="Center"/>
                                            <Button Grid.Column="1"
                                                    Text="Удалить"
                                                    FontSize="12"
                                                    BackgroundColor="{StaticResource Error}"
                                                    TextColor="{StaticResource White}"
                                                    CornerRadius="10"
                                                    Padding="10,4"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveOutputCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>

                                        <!-- Тип результата -->
                                        <Border BackgroundColor="{StaticResource BackgroundInput}"
                                                StrokeThickness="0"
                                                Padding="12,0"
                                                HeightRequest="{Binding PickerHeight}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12"/>
                                            </Border.StrokeShape>
                                            <Picker Title="Тип результата"
                                                    ItemsSource="{Binding TypeOptions}"
                                                    SelectedItem="{Binding SelectedType}"
                                                    TextColor="{StaticResource White}"
                                                    TitleColor="{StaticResource Gray500}" />
                                        </Border>

                                        <!-- Для материала: поле ввода кода + кнопка сканирования -->
                                        <VerticalStackLayout Spacing="8" IsVisible="{Binding IsMaterialSelected}">
                                            <Label Text="Код материала (артикул)"
                                                   FontSize="13"
                                                   TextColor="{StaticResource Gray400}" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Border Grid.Column="0"
                                                        BackgroundColor="{StaticResource BackgroundInput}"
                                                        StrokeThickness="0"
                                                        Padding="12,0"
                                                        HeightRequest="48">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="12"/>
                                                    </Border.StrokeShape>
                                                    <Entry Placeholder="Введите или отсканируйте код"
                                                           Text="{Binding MaterialCode}"
                                                           TextColor="{StaticResource White}"
                                                           PlaceholderColor="{StaticResource Gray600}"
                                                           BackgroundColor="Transparent"
                                                           VerticalOptions="Center" />
                                                </Border>
                                                <Button Grid.Column="1"
                                                        Text="📷"
                                                        FontSize="18"
                                                        BackgroundColor="{StaticResource CardScanner}"
                                                        TextColor="{StaticResource White}"
                                                        CornerRadius="12"
                                                        WidthRequest="48"
                                                        HeightRequest="48"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ScanMaterialCodeCommand}"
                                                        CommandParameter="{Binding .}" />
                                            </Grid>
                                            <Label Text="Название материала"
                                                   FontSize="13"
                                                   TextColor="{StaticResource Gray400}" />
                                            <Border BackgroundColor="{StaticResource BackgroundInput}"
                                                    StrokeThickness="0"
                                                    Padding="12,0"
                                                    HeightRequest="48">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12"/>
                                                </Border.StrokeShape>
                                                <Entry Placeholder="Название нового материала"
                                                       Text="{Binding MaterialName}"
                                                       TextColor="{StaticResource White}"
                                                       PlaceholderColor="{StaticResource Gray600}"
                                                       BackgroundColor="Transparent"
                                                       VerticalOptions="Center" />
                                            </Border>
                                            <Label Text="Единица измерения"
                                                   FontSize="13"
                                                   TextColor="{StaticResource Gray400}" />
                                            <Border BackgroundColor="{StaticResource BackgroundInput}"
                                                    StrokeThickness="0"
                                                    Padding="12,0"
                                                    HeightRequest="{Binding PickerHeight}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12"/>
                                                </Border.StrokeShape>
                                                <Picker Title="Выберите единицу"
                                                        ItemsSource="{Binding MeasuringUnitOptions}"
                                                        SelectedItem="{Binding MaterialMeasuringUnit}"
                                                        TextColor="{StaticResource White}"
                                                        TitleColor="{StaticResource Gray500}" />
                                            </Border>
                                        </VerticalStackLayout>

                                        <!-- Для продукта: поиск и выбор из каталога -->
                                        <VerticalStackLayout Spacing="8" IsVisible="{Binding IsProductSelected}">
                                            <Label Text="Выберите продукт из каталога"
                                                   FontSize="13"
                                                   TextColor="{StaticResource Gray400}" />
                                            <Border BackgroundColor="{StaticResource BackgroundInput}"
                                                    StrokeThickness="0"
                                                    Padding="12,0"
                                                    HeightRequest="48">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12"/>
                                                </Border.StrokeShape>
                                                <Entry Placeholder="🔍 Поиск по названию или артикулу..."
                                                       Text="{Binding ProductSearchText}"
                                                       TextColor="{StaticResource White}"
                                                       PlaceholderColor="{StaticResource Gray600}"
                                                       BackgroundColor="Transparent"
                                                       VerticalOptions="Center" />
                                            </Border>
                                            <Border BackgroundColor="{StaticResource BackgroundInput}"
                                                    StrokeThickness="0"
                                                    Padding="12,0"
                                                    HeightRequest="{Binding PickerHeight}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12"/>
                                                </Border.StrokeShape>
                                                <Picker Title="Выберите продукт"
                                                        ItemsSource="{Binding FilteredProducts}"
                                                        SelectedItem="{Binding SelectedProduct}"
                                                        ItemDisplayBinding="{Binding DisplayNameWithCode}"
                                                        TextColor="{StaticResource White}"
                                                        TitleColor="{StaticResource Gray500}" />
                                            </Border>
                                            <Label Text="{Binding SelectedProductInfo}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource CardReprocess}"
                                                   IsVisible="{Binding HasSelectedProduct}" />
                                        </VerticalStackLayout>

                                        <!-- Количество -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Border Grid.Column="0"
                                                    BackgroundColor="{StaticResource BackgroundInput}"
                                                    StrokeThickness="0"
                                                    Padding="12,0"
                                                    HeightRequest="48">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12"/>
                                                </Border.StrokeShape>
                                                <Entry Keyboard="Numeric"
                                                       Placeholder="Количество"
                                                       Text="{Binding Quantity}"
                                                       TextColor="{StaticResource White}"
                                                       PlaceholderColor="{StaticResource Gray600}"
                                                       BackgroundColor="Transparent"
                                                       VerticalOptions="Center" />
                                            </Border>
                                            <Label Grid.Column="1"
                                                   Text="{Binding MeasuringUnit}"
                                                   FontSize="14"
                                                   TextColor="{StaticResource CardReprocess}"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding MeasuringUnit, Converter={StaticResource IsStringNotEmptyConverter}}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Text="Добавить результат"
                            BackgroundColor="{StaticResource CardReprocess}"
                            TextColor="{StaticResource White}"
                            CornerRadius="12"
                            FontSize="14"
                            HeightRequest="42"
                            Command="{Binding AddOutputCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Defect Section -->
            <Border BackgroundColor="{StaticResource BackgroundCard}"
                    StrokeThickness="0"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="10">
                        <Border BackgroundColor="{StaticResource Error}"
                                WidthRequest="32"
                                HeightRequest="32"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Label Text="🗑️" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Брак (в утиль)"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <Label Text="Количество брака из исходного материала"
                           FontSize="13"
                           TextColor="{StaticResource Gray400}" />
                    <Border BackgroundColor="{StaticResource BackgroundInput}"
                            StrokeThickness="0"
                            Padding="12,0"
                            HeightRequest="48">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Entry x:Name="DefectQuantityEntry"
                               Keyboard="Numeric"
                               Placeholder="0"
                               Text="0"
                               TextColor="{StaticResource White}"
                               PlaceholderColor="{StaticResource Gray600}"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center" />
                    </Border>
                    <Label Text="Брак будет автоматически отправлен на склад Утиль"
                           FontSize="11"
                           TextColor="{StaticResource Gray500}" />
                </VerticalStackLayout>
            </Border>

            <!-- Note Section -->
            <Border BackgroundColor="{StaticResource BackgroundCard}"
                    StrokeThickness="0"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Примечание (необязательно)"
                           FontSize="14"
                           TextColor="{StaticResource Gray400}" />
                    <Border BackgroundColor="{StaticResource BackgroundInput}"
                            StrokeThickness="0"
                            Padding="12"
                            MinimumHeightRequest="80">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Editor x:Name="NoteEditor"
                                Placeholder="Дополнительная информация о переработке..."
                                TextColor="{StaticResource White}"
                                PlaceholderColor="{StaticResource Gray600}"
                                BackgroundColor="Transparent"
                                AutoSize="TextChanges"/>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Submit Button -->
            <Button Text="Переработать"
                    Clicked="OnSubmitClicked"
                    BackgroundColor="{StaticResource CardReprocess}"
                    TextColor="{StaticResource White}"
                    CornerRadius="14"
                    HeightRequest="52"
                    FontSize="16"
                    FontAttributes="Bold"
                    Margin="0,8,0,16" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
