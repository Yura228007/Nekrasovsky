<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NekrasovskyAPP.Pages.RolePermissionsPage"
             BackgroundColor="{StaticResource BackgroundDark}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Сохранить" Clicked="OnSaveClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,12">
                <VerticalStackLayout>
                    <Label Text="Управление ролями"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}" />
                    <Label Text="Права доступа ролей"
                           FontSize="12"
                           TextColor="{StaticResource Gray500}" />
                </VerticalStackLayout>
                <Border Grid.Column="1"
                        BackgroundColor="{StaticResource Secondary}"
                        WidthRequest="44"
                        HeightRequest="44"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Label Text="🔐" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </Grid>

            <!-- Выбор роли -->
            <Border BackgroundColor="{StaticResource BackgroundCard}"
                    StrokeThickness="0"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Выберите роль"
                           TextColor="{StaticResource White}"
                           FontAttributes="Bold"
                           FontSize="15" />
                    <Border x:Name="RolePickerBorder"
                            BackgroundColor="{StaticResource BackgroundInput}"
                            StrokeThickness="0"
                            Padding="12,0"
                            HeightRequest="48">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Picker x:Name="RolePicker"
                                Title="Выберите роль"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedIndexChanged="OnRoleSelected"
                                TextColor="{StaticResource White}"
                                TitleColor="{StaticResource Gray500}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Информация о выбранной роли -->
            <Border x:Name="RoleInfoContainer"
                    BackgroundColor="{StaticResource BackgroundCard}"
                    StrokeThickness="0"
                    Padding="16"
                    IsVisible="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border BackgroundColor="{StaticResource Secondary}"
                            WidthRequest="48"
                            HeightRequest="48"
                            StrokeThickness="0"
                            VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Label Text="👤" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label x:Name="RoleNameLabel"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}" />
                        <Label x:Name="RoleCodeLabel"
                               FontSize="13"
                               TextColor="{StaticResource Primary}" />
                        <Label x:Name="RoleDescriptionLabel"
                               FontSize="12"
                               TextColor="{StaticResource Gray500}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Список прав -->
            <Border x:Name="PermissionsContainer"
                    BackgroundColor="{StaticResource BackgroundCard}"
                    StrokeThickness="0"
                    Padding="16"
                    IsVisible="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="10">
                        <Border BackgroundColor="{StaticResource Primary}"
                                WidthRequest="32"
                                HeightRequest="32"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Label Text="🔑" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Права роли"
                               TextColor="{StaticResource White}"
                               FontAttributes="Bold"
                               FontSize="16"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <VerticalStackLayout x:Name="PermissionsList"
                                         BindableLayout.ItemsSource="{Binding Permissions}"
                                         Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{StaticResource BackgroundElevated}"
                                        StrokeThickness="0"
                                        Padding="14">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                        <Switch IsToggled="{Binding IsSelected, Mode=TwoWay}"
                                                Grid.Column="0"
                                                OnColor="{StaticResource Primary}"
                                                ThumbColor="{StaticResource White}"
                                                VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1"
                                                             VerticalOptions="Center"
                                                             Spacing="4">
                                            <Label Text="{Binding Permission.Name}"
                                                   TextColor="{StaticResource White}"
                                                   FontAttributes="Bold"
                                                   FontSize="14" />
                                            <Label Text="{Binding Permission.Description}"
                                                   TextColor="{StaticResource Gray400}"
                                                   FontSize="12"
                                                   LineBreakMode="WordWrap" />
                                            <Label Text="{Binding Permission.Code}"
                                                   TextColor="{StaticResource Primary}"
                                                   FontSize="11" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Кнопка сохранения -->
            <Button x:Name="SaveButton"
                    Text="Сохранить изменения"
                    Clicked="OnSaveClicked"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource White}"
                    CornerRadius="14"
                    FontAttributes="Bold"
                    HeightRequest="52"
                    FontSize="16"
                    IsVisible="False"
                    Margin="0,8,0,16" />

            <!-- Индикатор загрузки -->
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="{StaticResource Primary}"
                               HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
