<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NekrasovskyAPP.Pages.MaterialsPage"
             Title="Материалы"
             BackgroundColor="{StaticResource BackgroundDark}">
    
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Обновить" Clicked="OnRefreshClicked" />
        <ToolbarItem Text="Добавить" Clicked="OnAddClicked" />
    </ContentPage.ToolbarItems>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <!-- Search Bar -->
        <Border Grid.Row="0" 
                BackgroundColor="{StaticResource BackgroundCard}"
                StrokeThickness="1"
                Stroke="{StaticResource BorderColor}"
                Padding="15,12"
                Margin="15,15,15,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12"/>
            </Border.StrokeShape>
            <Entry x:Name="SearchEntry"
                   Placeholder="Поиск по названию или коду..."
                   TextChanged="OnSearchTextChanged"
                   TextColor="{StaticResource Gray200}"
                   PlaceholderColor="{StaticResource Gray600}"
                   BackgroundColor="Transparent" />
        </Border>
        
        <!-- Materials List -->
        <RefreshView Grid.Row="1" 
                     IsRefreshing="{Binding IsLoading}"
                     Refreshing="OnRefreshing">
            <CollectionView x:Name="MaterialsCollectionView"
                          ItemsSource="{Binding Materials}"
                          SelectionMode="Single"
                          SelectionChanged="OnMaterialSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{StaticResource BackgroundCard}"
                                StrokeThickness="1"
                                Stroke="{StaticResource BorderColor}"
                                Margin="15,8"
                                Padding="18">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Name}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource White}" />
                                <Label Text="{Binding Code, StringFormat='Код: {0}'}"
                                       FontSize="14"
                                       TextColor="{StaticResource Gray400}" />
                                <Label Text="{Binding MeasuringUnit, StringFormat='Ед. измерения: {0}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray600}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        
        <!-- Loading Indicator -->
        <ActivityIndicator Grid.Row="1"
                          IsRunning="{Binding IsLoading}"
                          IsVisible="{Binding IsLoading}"
                          Color="{StaticResource Accent}"
                          VerticalOptions="Center"
                          HorizontalOptions="Center" />
    </Grid>
    
</ContentPage>
