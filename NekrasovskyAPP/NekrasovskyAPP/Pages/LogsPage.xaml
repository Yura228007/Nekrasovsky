<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NekrasovskyAPP.Pages.LogsPage"
             BackgroundColor="{StaticResource BackgroundDark}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Экспорт CSV" Clicked="OnExportCsvClicked" />
        <ToolbarItem Text="Экспорт Excel" Clicked="OnExportExcelClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="10">

        <!-- Search Bar -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource BackgroundCard}"
                StrokeThickness="1"
                Stroke="{StaticResource BorderColor}"
                Margin="0,0,0,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto" Padding="10">
                <Entry x:Name="SearchEntry"
                       Grid.Column="0"
                       Placeholder="Поиск логов..."
                       PlaceholderColor="{StaticResource Gray400}"
                       TextColor="{StaticResource White}"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Поиск"
                        Clicked="OnSearchClicked"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource White}"
                        CornerRadius="8"
                        Padding="15,8" />
            </Grid>
        </Border>

        <!-- Error Message -->
        <Label Grid.Row="1"
               Text="{Binding ErrorMessage}"
               TextColor="#FF6B6B"
               FontSize="12"
               Margin="4,0,4,6" />

        <!-- Filters Panel -->
        <Border Grid.Row="2"
                BackgroundColor="{StaticResource BackgroundCard}"
                StrokeThickness="1"
                Stroke="{StaticResource BorderColor}"
                Margin="0,0,0,10"
                Padding="15">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="10">

                <Label Text="Фильтры"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{StaticResource White}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="10">

                    <!-- User Filter -->
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="Пользователь (ID)"
                               FontSize="12"
                               TextColor="{StaticResource Gray400}" />
                        <Entry x:Name="UserIdEntry"
                               Placeholder="ID пользователя"
                               PlaceholderColor="{StaticResource Gray400}"
                               TextColor="{StaticResource White}"
                               BackgroundColor="{StaticResource BackgroundDark}"
                               Keyboard="Numeric" />
                    </VerticalStackLayout>

                    <!-- Warehouse Filter -->
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Склад (ID)"
                               FontSize="12"
                               TextColor="{StaticResource Gray400}" />
                        <Entry x:Name="WarehouseIdEntry"
                               Placeholder="ID склада"
                               PlaceholderColor="{StaticResource Gray400}"
                               TextColor="{StaticResource White}"
                               BackgroundColor="{StaticResource BackgroundDark}"
                               Keyboard="Numeric" />
                    </VerticalStackLayout>

                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowSpacing="10">

                    <!-- Material Filter -->
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="Материал (ID)"
                               FontSize="12"
                               TextColor="{StaticResource Gray400}" />
                        <Entry x:Name="MaterialIdEntry"
                               Placeholder="ID материала"
                               PlaceholderColor="{StaticResource Gray400}"
                               TextColor="{StaticResource White}"
                               BackgroundColor="{StaticResource BackgroundDark}"
                               Keyboard="Numeric" />
                    </VerticalStackLayout>

                    <!-- Product Filter -->
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Продукт (ID)"
                               FontSize="12"
                               TextColor="{StaticResource Gray400}" />
                        <Entry x:Name="ProductIdEntry"
                               Placeholder="ID продукта"
                               PlaceholderColor="{StaticResource Gray400}"
                               TextColor="{StaticResource White}"
                               BackgroundColor="{StaticResource BackgroundDark}"
                               Keyboard="Numeric" />
                    </VerticalStackLayout>

                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                    <!-- Start Date Filter -->
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="Дата начала"
                               FontSize="12"
                               TextColor="{StaticResource Gray400}" />
                        <DatePicker x:Name="StartDatePicker"
                                    TextColor="{StaticResource White}"
                                    BackgroundColor="{StaticResource BackgroundDark}" />
                    </VerticalStackLayout>

                    <!-- End Date Filter -->
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Дата окончания"
                               FontSize="12"
                               TextColor="{StaticResource Gray400}" />
                        <DatePicker x:Name="EndDatePicker"
                                    TextColor="{StaticResource White}"
                                    BackgroundColor="{StaticResource BackgroundDark}" />
                    </VerticalStackLayout>

                </Grid>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="Применить"
                            Clicked="OnApplyFiltersClicked"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource White}"
                            CornerRadius="8" />
                    <Button Grid.Column="1"
                            Text="Сбросить"
                            Clicked="OnResetFiltersClicked"
                            BackgroundColor="{StaticResource Gray600}"
                            TextColor="{StaticResource White}"
                            CornerRadius="8" />
                    <Button Grid.Column="2"
                            Text="Обновить"
                            Clicked="OnRefreshClicked"
                            BackgroundColor="{StaticResource Accent}"
                            TextColor="{StaticResource White}"
                            CornerRadius="8" />
                </Grid>

            </VerticalStackLayout>
        </Border>

        <!-- Logs List -->
        <CollectionView Grid.Row="3"
                        x:Name="LogsCollectionView"
                        ItemsSource="{Binding Logs}"
                        SelectionMode="Single"
                        SelectionChanged="OnLogSelected">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                    <Label Text="Нет логов для отображения"
                           FontSize="16"
                           TextColor="{StaticResource Gray400}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Попробуйте изменить параметры фильтрации"
                           FontSize="12"
                           TextColor="{StaticResource Gray500}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="{StaticResource BackgroundCard}"
                            StrokeThickness="1"
                            Stroke="{StaticResource BorderColor}"
                            Margin="0,0,0,8"
                            Padding="12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">

                            <!-- HTTP Method Badge -->
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource Primary}"
                                    Padding="8,4"
                                    VerticalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="4"/>
                                </Border.StrokeShape>
                                <Label Text="{Binding HttpMethod}"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource White}"
                                       HorizontalOptions="Center" />
                            </Border>

                            <!-- Log Details -->
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding Url}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource White}"
                                       LineBreakMode="TailTruncation" />
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding Controller, TargetNullValue='-'}"
                                           FontSize="11"
                                           TextColor="{StaticResource Gray400}" />
                                    <Label Text="/"
                                           FontSize="11"
                                           TextColor="{StaticResource Gray500}" />
                                    <Label Text="{Binding Action, TargetNullValue='-'}"
                                           FontSize="11"
                                           TextColor="{StaticResource Gray400}" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding RequestTime, StringFormat='{0:dd.MM.yyyy HH:mm:ss}'}"
                                       FontSize="10"
                                       TextColor="{StaticResource Gray500}" />
                            </VerticalStackLayout>

                            <!-- Status and Duration -->
                            <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="End">
                                <Border BackgroundColor="{Binding StatusCodeColor}"
                                        Padding="6,3">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4"/>
                                    </Border.StrokeShape>
                                    <Label Text="{Binding StatusCode}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource White}"
                                           HorizontalOptions="Center" />
                                </Border>
                                <Label Text="{Binding DurationMs, StringFormat='{0} ms'}"
                                       FontSize="10"
                                       TextColor="{StaticResource Gray400}"
                                       HorizontalTextAlignment="End" />
                            </VerticalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Pagination -->
        <Border Grid.Row="4"
                BackgroundColor="{StaticResource BackgroundCard}"
                StrokeThickness="1"
                Stroke="{StaticResource BorderColor}"
                Margin="0,10,0,0"
                Padding="10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">

                <Button Grid.Column="0"
                        x:Name="PreviousButton"
                        Text="← Назад"
                        Clicked="OnPreviousPageClicked"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource White}"
                        CornerRadius="6"
                        Padding="15,8" />

                <VerticalStackLayout Grid.Column="1"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="2">
                    <Label HorizontalTextAlignment="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Страница "
                                      TextColor="{StaticResource Gray400}"
                                      FontSize="12" />
                                <Span Text="{Binding CurrentPage}"
                                      TextColor="{StaticResource White}"
                                      FontSize="12"
                                      FontAttributes="Bold" />
                                <Span Text=" из "
                                      TextColor="{StaticResource Gray400}"
                                      FontSize="12" />
                                <Span Text="{Binding TotalPages}"
                                      TextColor="{StaticResource White}"
                                      FontSize="12"
                                      FontAttributes="Bold" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="{Binding TotalLogsCount, StringFormat='Всего логов: {0}'}"
                           FontSize="10"
                           TextColor="{StaticResource Gray500}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Button Grid.Column="2"
                        x:Name="NextButton"
                        Text="Вперед →"
                        Clicked="OnNextPageClicked"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource White}"
                        CornerRadius="6"
                        Padding="15,8" />

            </Grid>
        </Border>

    </Grid>

</ContentPage>
