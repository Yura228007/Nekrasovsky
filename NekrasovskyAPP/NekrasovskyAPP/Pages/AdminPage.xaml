<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NekrasovskyAPP.Pages.AdminPage"
             Title="Панель администратора"
             BackgroundColor="{StaticResource BackgroundDark}">
    
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Выход" Clicked="OnLogoutClicked" />
    </ContentPage.ToolbarItems>
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <!-- Header -->
            <Label Text="Панель администратора"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{StaticResource White}"
                   HorizontalOptions="Center"
                   Margin="0,10,0,10" />
            
            <StackLayout Padding="10,5">
                <Label Text="{Binding CurrentUserName}"
                    FontSize="12"
                    TextColor="{StaticResource Gray400}"
                    HorizontalOptions="End"
                    Margin="0,0,10,0" />
            </StackLayout>
            
            <!-- Admin Navigation Cards -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="*,*,*,*" ColumnSpacing="15" RowSpacing="15">
                
                <!-- Users Management -->
                <Border Grid.Row="0" Grid.Column="0"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="1"
                        Stroke="{StaticResource BorderColor}"
                        Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="👥" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Управление пользователями" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        <Button Text="Открыть"
                                Clicked="OnUsersClicked"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                CornerRadius="10" />
                    </VerticalStackLayout>
                </Border>
                
                <!-- Products Management -->
                <Border Grid.Row="0" Grid.Column="1"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="1"
                        Stroke="{StaticResource BorderColor}"
                        Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="📦" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Управление продуктами" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        <Button Text="Открыть"
                                Clicked="OnProductsClicked"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                CornerRadius="10" />
                    </VerticalStackLayout>
                </Border>
                
                <!-- Materials Management -->
                <Border Grid.Row="1" Grid.Column="0"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="1"
                        Stroke="{StaticResource BorderColor}"
                        Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="🔧" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Управление материалами" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        <Button Text="Открыть"
                                Clicked="OnMaterialsClicked"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                CornerRadius="10" />
                    </VerticalStackLayout>
                </Border>
                
                <!-- Warehouses Management -->
                <Border Grid.Row="1" Grid.Column="1"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="1"
                        Stroke="{StaticResource BorderColor}"
                        Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="🏭" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Управление складами" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        <Button Text="Открыть"
                                Clicked="OnWarehousesClicked"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                CornerRadius="10" />
                    </VerticalStackLayout>
                </Border>
                
                <!-- Reports -->
                <Border Grid.Row="2" Grid.Column="0"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="1"
                        Stroke="{StaticResource BorderColor}"
                        Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="📊" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Отчеты" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        <Button Text="Открыть"
                                Clicked="OnReportsClicked"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                CornerRadius="10" />
                    </VerticalStackLayout>
                </Border>
                
                <!-- System Settings -->
                <Border Grid.Row="2" Grid.Column="1"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="1"
                        Stroke="{StaticResource BorderColor}"
                        Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="⚙️" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Настройки системы"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        <Button Text="Открыть"
                                Clicked="OnSettingsClicked"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                CornerRadius="10" />
                    </VerticalStackLayout>
                </Border>

                <!-- Logs Management -->
                <Border Grid.Row="3" Grid.Column="0"
                        BackgroundColor="{StaticResource BackgroundCard}"
                        StrokeThickness="1"
                        Stroke="{StaticResource BorderColor}"
                        Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="📋" FontSize="40" HorizontalOptions="Center" />
                        <Label Text="Системные логи"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        <Button Text="Открыть"
                                Clicked="OnLogsClicked"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="{StaticResource White}"
                                CornerRadius="10" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- Alarm Button -->
            <Border Margin="0,20,0,0"
                    BackgroundColor="#DC3545"
                    StrokeThickness="2"
                    Stroke="#FF6B6B"
                    Padding="25"
                    HorizontalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Button x:Name="AlarmButton"
                        Text="🚨 ТРЕВОГА"
                        FontSize="24"
                        FontAttributes="Bold"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource White}"
                        BorderColor="Transparent"
                        BorderWidth="0"
                        Clicked="OnAlarmClicked"
                        HorizontalOptions="Fill"
                        HeightRequest="80" />
            </Border>
            
        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>
